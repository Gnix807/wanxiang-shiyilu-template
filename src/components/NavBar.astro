---
import { siteConfig, navConfig, i18nConfig } from '../config/site';

const { pathname } = Astro.url;

// 从配置中获取导航项
const nav = navConfig.desktop;
const ext = navConfig.external;
const mob = navConfig.mobileMore;

const isTalkPage = pathname === '/talks' || pathname.startsWith('/talks/');
const isPostPage = pathname === '/' || pathname.startsWith('/page/') || pathname.startsWith('/posts/') || pathname.startsWith('/category/') || pathname.startsWith('/tag/');
const isAboutPage = pathname === '/about';
const isFriendsPage = pathname === '/friends' || pathname === '/links';
const isArchivePage = pathname === '/posts';
const isTagsPage = pathname === '/tags' || pathname.startsWith('/tag/') || pathname.startsWith('/tags/');
const isBlogStatsPage = pathname === '/blogstats';
---

<div class="fixed top-0 left-0 right-0 z-[100] bg-white dark:bg-[#1c1b1a] border-b-2 border-[#1a1a1a] dark:border-[#e8e6e3] px-3 py-2 sm:px-6 sm:py-3 shadow-[0px_2px_0px_0px_rgba(26,26,26,0.12)] dark:shadow-[0px_2px_0px_0px_rgba(232,230,227,0.1)]" transition:name="navbar" transition:persist data-prefetch="nav">
  <div class="max-w-[1440px] mx-auto flex justify-between items-center gap-2">
    <a href="/" class="flex items-center gap-2 sm:gap-2.5 text-[#1a1a1a] dark:text-[#e8e6e3] shrink-0 hover:opacity-80 transition-opacity min-w-0">
      <span class="w-8 h-8 sm:w-9 sm:h-9 flex items-center justify-center bg-[#f4efe6] dark:bg-[#242220] border-2 border-[#1a1a1a] dark:border-[#e8e6e3] font-black text-lg transform -skew-x-12 shadow-[1.5px_1.5px_0px_0px_#1a1a1a] sm:shadow-[2px_2px_0px_0px_#1a1a1a] dark:shadow-[1.5px_1.5px_0px_0px_#e8e6e3] overflow-hidden shrink-0">
        <img 
          src={siteConfig.avatar} 
          alt={siteConfig.author} 
          width="40" 
          height="40" 
          decoding="async" 
          class="w-full h-full object-cover max-w-none" 
          style="transform: skewX(12deg) scale(1.6); transform-origin: center;" 
          referrer-policy="no-referrer" 
        />
      </span>
      <span class="font-black tracking-widest uppercase inline-block truncate text-sm sm:text-base font-sans">{siteConfig.title}</span>
      <span class="hidden md:inline-block text-[9px] font-mono tracking-[0.2em] text-[#9e2a2b] dark:text-[#d9534f] font-black border-l-2 border-[#1a1a1a]/25 dark:border-[#e8e6e3]/25 pl-2 ml-0.5 select-none">{siteConfig.enTitle}</span>
    </a>
    
    <div class="flex items-center gap-1 sm:gap-3 pb-1 -mb-1 min-w-0 justify-end relative">
      {nav[0] && (<a
        href={nav[0].href}
        class={`px-1.5 py-0.5 sm:px-3 sm:py-1.5 border-2 border-[#1a1a1a] dark:border-[#e8e6e3] flex items-center gap-0.5 sm:gap-1.5 transition-colors cursor-pointer rounded-sm font-bold uppercase text-xs sm:text-sm tracking-wider shrink-0 whitespace-nowrap ${
          isPostPage ? 'bg-[#9e2a2b] dark:bg-[#d9534f] text-white shadow-[1px_1px_0px_0px_#1a1a1a] sm:shadow-[2px_2px_0px_0px_#1a1a1a] dark:shadow-[1px_1px_0px_0px_#e8e6e3]' : 'text-[#1a1a1a] dark:text-[#e8e6e3] shadow-[1px_1px_0px_0px_#e6e4df] sm:shadow-[2px_2px_0px_0px_#e6e4df] dark:shadow-[1px_1px_0px_0px_#2d2b28] bg-white dark:bg-[#1c1b1a] hover:bg-[#f4efe6] dark:hover:bg-[#242220] hover:text-[#9e2a2b]'
        }`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 sm:w-4 sm:h-4 stroke-[2.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        <span>{nav[0].name}</span>
      </a>)}
      {nav[1] && (<a
        href={nav[1].href}
        class={`px-1.5 py-0.5 sm:px-3 sm:py-1.5 border-2 border-[#1a1a1a] dark:border-[#e8e6e3] flex items-center gap-0.5 sm:gap-1.5 transition-colors cursor-pointer rounded-sm font-bold uppercase text-xs sm:text-sm tracking-wider shrink-0 whitespace-nowrap ${
          isTalkPage ? 'bg-[#9e2a2b] dark:bg-[#d9534f] text-white shadow-[1px_1px_0px_0px_#1a1a1a] sm:shadow-[2px_2px_0px_0px_#1a1a1a] dark:shadow-[1px_1px_0px_0px_#e8e6e3]' : 'text-[#1a1a1a] dark:text-[#e8e6e3] shadow-[1px_1px_0px_0px_#e6e4df] sm:shadow-[2px_2px_0px_0px_#e6e4df] dark:shadow-[1px_1px_0px_0px_#2d2b28] bg-white dark:bg-[#1c1b1a] hover:bg-[#f4efe6] dark:hover:bg-[#242220] hover:text-[#9e2a2b]'
        }`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 sm:w-4 sm:h-4 stroke-[2.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
        </svg>
        <span>{nav[1].name}</span>
      </a>)}
      
      {nav[2] && (<a
        href={nav[2].href}
        class={`hidden sm:flex px-1.5 py-0.5 sm:px-3 sm:py-1.5 border-2 border-[#1a1a1a] dark:border-[#e8e6e3] items-center gap-0.5 sm:gap-1.5 transition-colors cursor-pointer rounded-sm font-bold uppercase text-xs sm:text-sm tracking-wider shrink-0 whitespace-nowrap ${
          isFriendsPage ? 'bg-[#9e2a2b] dark:bg-[#d9534f] text-white shadow-[1px_1px_0px_0px_#1a1a1a] sm:shadow-[2px_2px_0px_0px_#1a1a1a] dark:shadow-[1px_1px_0px_0px_#e8e6e3]' : 'text-[#1a1a1a] dark:text-[#e8e6e3] shadow-[1px_1px_0px_0px_#e6e4df] sm:shadow-[2px_2px_0px_0px_#e6e4df] dark:shadow-[1px_1px_0px_0px_#2d2b28] bg-white dark:bg-[#1c1b1a] hover:bg-[#f4efe6] dark:hover:bg-[#242220] hover:text-[#9e2a2b]'
        }`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class={`w-3 h-3 sm:w-4 sm:h-4 ${isFriendsPage ? 'fill-white stroke-white' : 'stroke-[#9e2a2b] fill-[#9e2a2b]/30'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
        </svg>
        <span>{nav[2].name}</span>
      </a>)}

      {nav[3] && (<a
        href={nav[3].href}
        class={`hidden md:flex px-1.5 py-0.5 sm:px-3 sm:py-1.5 border-2 border-[#1a1a1a] dark:border-[#e8e6e3] items-center gap-0.5 sm:gap-1.5 transition-colors cursor-pointer rounded-sm font-bold uppercase text-xs sm:text-sm tracking-wider shrink-0 whitespace-nowrap ${
          isAboutPage ? 'bg-[#9e2a2b] dark:bg-[#d9534f] text-white shadow-[1px_1px_0px_0px_#1a1a1a] sm:shadow-[2px_2px_0px_0px_#1a1a1a] dark:shadow-[1px_1px_0px_0px_#e8e6e3]' : 'text-[#1a1a1a] dark:text-[#e8e6e3] shadow-[1px_1px_0px_0px_#e6e4df] sm:shadow-[2px_2px_0px_0px_#e6e4df] dark:shadow-[1px_1px_0px_0px_#2d2b28] bg-white dark:bg-[#1c1b1a] hover:bg-[#f4efe6] dark:hover:bg-[#242220] hover:text-[#9e2a2b]'
        }`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 sm:w-4 sm:h-4 stroke-[2.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        <span>{nav[3].name}</span>
      </a>)}

      {nav[4] && (<a
        href={nav[4].href}
        class={`hidden lg:flex px-1.5 py-0.5 sm:px-3 sm:py-1.5 border-2 border-[#1a1a1a] dark:border-[#e8e6e3] items-center gap-0.5 sm:gap-1.5 transition-colors cursor-pointer rounded-sm font-bold uppercase text-xs sm:text-sm tracking-wider shrink-0 whitespace-nowrap ${
          isArchivePage ? 'bg-[#9e2a2b] dark:bg-[#d9534f] text-white shadow-[1px_1px_0px_0px_#1a1a1a] sm:shadow-[2px_2px_0px_0px_#1a1a1a] dark:shadow-[1px_1px_0px_0px_#e8e6e3]' : 'text-[#1a1a1a] dark:text-[#e8e6e3] shadow-[1px_1px_0px_0px_#e6e4df] sm:shadow-[2px_2px_0px_0px_#e6e4df] dark:shadow-[1px_1px_0px_0px_#2d2b28] bg-white dark:bg-[#1c1b1a] hover:bg-[#f4efe6] dark:hover:bg-[#242220] hover:text-[#9e2a2b]'
        }`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 sm:w-4 sm:h-4 stroke-[2.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
        </svg>
        <span>{nav[4].name}</span>
      </a>)}

      {nav[5] && (<a
        href={nav[5].href}
        class={`hidden lg:flex px-1.5 py-0.5 sm:px-3 sm:py-1.5 border-2 border-[#1a1a1a] dark:border-[#e8e6e3] items-center gap-0.5 sm:gap-1.5 transition-colors cursor-pointer rounded-sm font-bold uppercase text-xs sm:text-sm tracking-wider shrink-0 whitespace-nowrap ${
          isBlogStatsPage ? 'bg-[#9e2a2b] dark:bg-[#d9534f] text-white shadow-[1px_1px_0px_0px_#1a1a1a] sm:shadow-[2px_2px_0px_0px_#1a1a1a] dark:shadow-[1px_1px_0px_0px_#e8e6e3]' : 'text-[#1a1a1a] dark:text-[#e8e6e3] shadow-[1px_1px_0px_0px_#e6e4df] sm:shadow-[2px_2px_0px_0px_#e6e4df] dark:shadow-[1px_1px_0px_0px_#2d2b28] bg-white dark:bg-[#1c1b1a] hover:bg-[#f4efe6] dark:hover:bg-[#242220] hover:text-[#9e2a2b]'
        }`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 sm:w-4 sm:h-4 stroke-[2.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        <span>{nav[5].name}</span>
      </a>)}

      {nav[6] && (<a
        href={nav[6].href}
        class={`hidden xl:flex px-1.5 py-0.5 sm:px-3 sm:py-1.5 border-2 border-[#1a1a1a] dark:border-[#e8e6e3] items-center gap-0.5 sm:gap-1.5 transition-colors cursor-pointer rounded-sm font-bold uppercase text-xs sm:text-sm tracking-wider shrink-0 whitespace-nowrap ${
          isTagsPage ? 'bg-[#9e2a2b] dark:bg-[#d9534f] text-white shadow-[1px_1px_0px_0px_#1a1a1a] sm:shadow-[2px_2px_0px_0px_#1a1a1a] dark:shadow-[1px_1px_0px_0px_#e8e6e3]' : 'text-[#1a1a1a] dark:text-[#e8e6e3] shadow-[1px_1px_0px_0px_#e6e4df] sm:shadow-[2px_2px_0px_0px_#e6e4df] dark:shadow-[1px_1px_0px_0px_#2d2b28] bg-white dark:bg-[#1c1b1a] hover:bg-[#f4efe6] dark:hover:bg-[#242220] hover:text-[#9e2a2b]'
        }`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 sm:w-4 sm:h-4 stroke-[2.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82zM7 7h.01" />
        </svg>
        <span>{nav[6].name}</span>
      </a>)}



      {ext[0] && (<a
        href={ext[0].href}
        target="_blank" rel="noopener noreferrer"
        class={`hidden xl:flex px-1.5 py-0.5 sm:px-3 sm:py-1.5 border-2 border-[#1a1a1a] dark:border-[#e8e6e3] items-center gap-0.5 sm:gap-1.5 transition-colors cursor-pointer rounded-sm font-bold uppercase text-xs sm:text-sm tracking-wider shrink-0 whitespace-nowrap text-[#1a1a1a] dark:text-[#e8e6e3] shadow-[1px_1px_0px_0px_#e6e4df] sm:shadow-[2px_2px_0px_0px_#e6e4df] dark:shadow-[1px_1px_0px_0px_#2d2b28] bg-white dark:bg-[#1c1b1a] hover:bg-[#f4efe6] dark:hover:bg-[#242220] hover:text-[#9e2a2b]`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 sm:w-4 sm:h-4 stroke-[2.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
        </svg>
        <span>{ext[0].name}</span>
      </a>)}

      <button
        type="button"
        id="desktop-search-toggle"
        class="hidden sm:flex px-2 py-0.5 sm:px-2.5 sm:py-1.5 border-2 border-[#1a1a1a] dark:border-[#e8e6e3] items-center gap-1.5 hover:bg-[#f4efe6] dark:hover:bg-[#242220] hover:text-[#9e2a2b] transition-colors cursor-pointer rounded-sm font-bold text-xs sm:text-sm tracking-wider shrink-0 whitespace-nowrap text-[#1a1a1a] dark:text-[#e8e6e3] shadow-[1px_1px_0px_0px_#e6e4df] sm:shadow-[2px_2px_0px_0px_#e6e4df] dark:shadow-[1px_1px_0px_0px_#2d2b28] bg-white dark:bg-[#1c1b1a]"
        aria-label="搜索 (Ctrl+K)"
        title="搜索文章与说说 (Ctrl+K)"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 stroke-[2.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span class="hidden md:inline font-sans">搜索</span>
        <kbd class="hidden md:inline-block text-[10px] font-mono px-1 py-0.5 bg-[#f4efe6] dark:bg-[#242220] border border-[#1a1a1a]/30 dark:border-[#e8e6e3]/30 rounded-xs text-[#736f68] dark:text-[#a8a29e] shadow-[1px_1px_0px_0px_rgba(0,0,0,0.15)] leading-none">Ctrl K</kbd>
      </button>

      <button
        id="dark-mode-toggle"
        data-theme-toggle
        class="px-1.5 py-0.5 sm:px-3 sm:py-1.5 border-2 border-[#1a1a1a] dark:border-[#e8e6e3] flex items-center gap-0.5 sm:gap-1.5 hover:bg-[#f4efe6] dark:hover:bg-[#242220] hover:text-[#9e2a2b] transition-colors cursor-pointer rounded-sm font-bold uppercase text-xs sm:text-sm tracking-wider shrink-0 whitespace-nowrap text-[#1a1a1a] dark:text-[#e8e6e3] shadow-[1px_1px_0px_0px_#e6e4df] sm:shadow-[2px_2px_0px_0px_#e6e4df] dark:shadow-[1px_1px_0px_0px_#2d2b28] bg-white dark:bg-[#1c1b1a]"
        aria-label={i18nConfig.common.toggleDarkMode}
      >
        <svg class="theme-sun w-3 h-3 sm:w-4 sm:h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m8.66-13.66l-.71.71M4.05 19.95l-.71.71M21 12h-1M4 12H3m15.66 7.66l-.71-.71M4.05 4.05l-.71-.71M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg class="theme-moon w-3 h-3 sm:w-4 sm:h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <div class="hidden sm:block relative self-center">
        <button
          id="desktop-more-toggle"
          class="px-1.5 py-0.5 sm:px-3 sm:py-1.5 border-2 border-[#1a1a1a] dark:border-[#e8e6e3] flex items-center gap-0.5 sm:gap-1.5 hover:bg-[#f4efe6] dark:hover:bg-[#242220] hover:text-[#9e2a2b] transition-colors cursor-pointer rounded-sm font-bold uppercase text-xs sm:text-sm tracking-wider shrink-0 whitespace-nowrap text-[#1a1a1a] dark:text-[#e8e6e3] shadow-[1px_1px_0px_0px_#e6e4df] sm:shadow-[2px_2px_0px_0px_#e6e4df] dark:shadow-[1px_1px_0px_0px_#2d2b28] bg-white dark:bg-[#1c1b1a]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 sm:w-4 sm:h-4 stroke-[3]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z" />
          </svg>
          <span class="hidden md:inline">{i18nConfig.common.more}</span>
        </button>
        <div id="desktop-more-dropdown" class="absolute right-0 mt-3 w-32 bg-white dark:bg-[#1c1b1a] border-2 border-[#1a1a1a] dark:border-[#e8e6e3] shadow-[3px_3px_0px_0px_#1a1a1a] dark:shadow-[3px_3px_0px_0px_#2d2b28] rounded-sm p-1.5 flex flex-col gap-1.5 z-[110] transform rotate-0.5 hidden">
          {nav[6] && (<a href={nav[6].href} class={`xl:hidden p-2 border border-[#1a1a1a]/20 dark:border-[#e8e6e3]/20 flex items-center justify-center gap-1.5 hover:bg-[#9e2a2b] hover:text-white transition-colors cursor-pointer rounded-sm font-bold uppercase text-[11px] tracking-wider select-none ${isTagsPage ? "bg-[#9e2a2b] text-white" : "bg-[#f4efe6] dark:bg-[#242220] text-[#1a1a1a] dark:text-[#e8e6e3]"}`}>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82zM7 7h.01" /></svg>
            {nav[6].name}
          </a>)}
          {ext[0] && (<a href={ext[0].href} target="_blank" rel="noopener noreferrer" class="xl:hidden p-2 border border-[#1a1a1a]/20 dark:border-[#e8e6e3]/20 flex items-center justify-center gap-1.5 hover:bg-[#9e2a2b] hover:text-white transition-colors cursor-pointer rounded-sm font-bold uppercase text-[11px] tracking-wider bg-[#f4efe6] dark:bg-[#242220] text-[#1a1a1a] dark:text-[#e8e6e3] select-none">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
            {ext[0].name}
          </a>)}
          <a href={mob[1].href} class="md:hidden p-2 border border-[#1a1a1a]/20 dark:border-[#e8e6e3]/20 flex items-center justify-center gap-1.5 hover:bg-[#9e2a2b] hover:text-white transition-colors cursor-pointer rounded-sm font-bold uppercase text-[11px] tracking-wider select-none bg-[#f4efe6] dark:bg-[#242220] text-[#1a1a1a] dark:text-[#e8e6e3]">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            {mob[1].name}
          </a>
