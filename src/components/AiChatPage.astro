---
// 独立全屏 AI 问答页 + 自绘 Dock 栏（不复用 NavBar）。
import { siteConfig, navConfig } from '../config/site';
const dockNav = navConfig.desktop.filter(n => !n.external && n.href !== '/ai');
const avatar = siteConfig.avatar;
const siteTitle = siteConfig.title;
---

<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>AI · 文章问答</title>
<link href="/fonts/fonts.css" rel="stylesheet">
<style is:global>
  :root {
    --accent: #9e2a2b;
    --accent-dark: #7a1f20;
    --accent-soft: #f4efe6;
    --bg: #fbfbf9;
    --panel: #ffffff;
    --fg: #1a1a1a;
    --muted: #736f68;
    --border: #e6e4df;
    --code-bg: #1c1b1a;
    --radius: 8px;
    --font-body: "Noto Serif SC", "Noto Sans SC", -apple-system, "PingFang SC", serif;
    --font-mono: "JetBrains Mono", ui-monospace, "SF Mono", monospace;
  }
  .dark {
    --bg: #141413;
    --panel: #1c1b1a;
    --fg: #e8e6e3;
    --muted: #9c978f;
    --border: #2d2b28;
    --accent: #d9534f;
    --accent-dark: #f87171;
    --accent-soft: #242220;
    --code-bg: #141413;
  }
  .dark header, .dark footer { background: rgba(20,20,19,0.86); }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  ::selection { background: var(--accent-soft); color: var(--accent-dark); }
  html, body { height: 100%; }
  body {
    font-family: var(--font-body);
    background: var(--bg);
    color: var(--fg);
    display: flex;
    flex-direction: column;
    -webkit-font-smoothing: antialiased;
  }

  /* ---------- 顶栏 Dock ---------- */
  header {
    flex-shrink: 0;
    padding: 8px 16px;
    display: flex; align-items: center; gap: 10px;
    border-bottom: 1px solid var(--border);
    background: rgba(255,255,255,0.86);
    backdrop-filter: saturate(180%) blur(10px);
    position: sticky; top: 0; z-index: 10;
  }
  .back-btn, .dock-btn {
    flex-shrink: 0;
    width: 34px; height: 34px;
    display: flex; align-items: center; justify-content: center;
    border: 1px solid var(--border); background: var(--panel);
    color: var(--muted); border-radius: 10px; cursor: pointer; font-size: 15px;
    transition: border-color .15s, color .15s;
  }
  .back-btn:hover, .dock-btn:hover { border-color: var(--accent); color: var(--accent); }
  .brand {
    flex-shrink: 0;
    display: flex; align-items: center; gap: 8px;
    text-decoration: none; color: var(--fg);
  }
  .brand img { width: 30px; height: 30px; border-radius: 8px; object-fit: cover; }
  .brand span { font-weight: 700; font-size: 15px; }
  .dock-nav {
    display: flex; align-items: center; gap: 2px;
    margin: 0 auto; overflow-x: auto; scrollbar-width: none;
  }
  .dock-nav::-webkit-scrollbar { display: none; }
  .dock-item {
    position: relative;
    flex-shrink: 0;
    width: 40px; height: 40px;
    display: flex; align-items: center; justify-content: center;
    font-size: 19px; text-decoration: none;
    border-radius: 11px;
    transition: transform .18s cubic-bezier(.34,1.56,.64,1), background .15s;
  }
  .dock-item:hover { transform: translateY(-4px) scale(1.15); background: var(--accent-soft); }
  .dock-item::after {
    content: attr(data-label);
    position: absolute; top: 100%; left: 50%;
    transform: translateX(-50%) translateY(4px);
    padding: 3px 8px; font-size: 11px; white-space: nowrap;
    background: var(--fg); color: var(--bg); border-radius: 6px;
    opacity: 0; pointer-events: none; transition: opacity .15s;
  }
  .dock-item:hover::after { opacity: 1; }
  .badge {
    font-size: 12px; color: var(--accent-dark);
    background: var(--accent-soft);
    padding: 4px 11px; border-radius: 999px;
    font-family: var(--font-mono); white-space: nowrap;
  }

  /* ---------- 消息区 ---------- */
  main {
    flex: 1;
    overflow-y: auto;
    padding: 28px 20px;
    width: 100%;
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 22px;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  main::-webkit-scrollbar { display: none; }

  .msg { display: flex; flex-direction: column; max-width: 88%; animation: msgIn .35s cubic-bezier(.22,1,.36,1) both; }
  .msg.user { align-self: flex-end; align-items: flex-end; }
  .msg.ai { align-self: flex-start; align-items: flex-start; max-width: 96%; }
  @keyframes msgIn { from { opacity: 0; transform: translateY(12px) scale(.98); } to { opacity: 1; transform: translateY(0) scale(1); } }

  .bubble {
    padding: 12px 16px;
    border-radius: var(--radius);
    line-height: 1.75;
    font-size: 15px;
    word-break: break-word;
  }
  .msg.user .bubble {
    background: var(--accent);
    color: #fff;
    border-radius: var(--radius) var(--radius) 6px var(--radius);
    box-shadow: 0 1px 3px rgba(158,42,43,.18);
  }
  .msg.ai .bubble {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius) var(--radius) var(--radius) 6px;
    box-shadow: 0 1px 2px rgba(0,0,0,.04);
  }

  .ansbox { line-height: 1.85; white-space: pre-wrap; word-break: break-word; overflow-wrap: break-word; max-width: 100%; }
  .flow { max-width: 100%; overflow-wrap: break-word; display: flex; flex-direction: column; gap: 6px; }
  .ansbox .pseg { margin: 2px 0 8px; white-space: pre-wrap; }
  .ansbox .psep { margin: 0; height: 2px; }
  .ansbox .mdh { font-weight: 700; font-size: 15.5px; margin: 14px 0 6px; color: var(--fg); }
  .ansbox .mdcode {
    background: var(--code-bg); color: #e2e8f0;
    padding: 12px 14px; border-radius: 10px;
    font-family: var(--font-mono); font-size: 13px; line-height: 1.6;
    margin: 8px 0; overflow-x: auto; white-space: pre;
  }
  .ansbox .mdquote {
    border-left: 3px solid var(--accent);
    padding: 6px 14px; margin: 10px 0;
    color: #475569; background: var(--panel); border-radius: 0 8px 8px 0;
  }
  .ansbox ul, .ansbox ol { margin: 6px 0 10px; padding-left: 24px; }
  .ansbox li { margin: 4px 0; }
  .ansbox code { background: var(--accent-soft); color: var(--accent-dark); padding: 1px 6px; border-radius: 5px; font-family: var(--font-mono); font-size: 13px; }
  .ansbox .mdtable { border-collapse: collapse; margin: 10px 0; width: 100%; font-size: 13.5px; }
  .ansbox .mdtable th, .ansbox .mdtable td { border: 1px solid var(--border); padding: 7px 11px; text-align: left; }
  .ansbox .mdtable th { background: var(--panel); color: var(--fg); font-weight: 600; }

  /* ---------- 思考折叠区 ---------- */
  .think-box { margin: 0 0 8px; border: 1px solid var(--border); border-radius: 10px; background: var(--panel); overflow: hidden; }
  .think-head {
    padding: 8px 13px; cursor: pointer;
    display: flex; align-items: center; gap: 7px;
    font-size: 12.5px; color: var(--muted); user-select: none;
  }
  .think-head:hover { background: #eef0f2; }
  .think-body {
    max-height: 0; overflow: hidden;
    color: #64748b; font-size: 12.5px; line-height: 1.7;
    white-space: pre-wrap; word-break: break-word;
    transition: max-height .45s ease, padding .25s ease;
  }
  .think-box.open .think-body { max-height: 2000px; padding: 4px 14px 12px; }
  .think-box.open .think-head { border-bottom: 1px dashed var(--border); }

  .msg.ai .bubble a { color: var(--accent); text-decoration: none; border-bottom: 1px solid rgba(158,42,43,.35); }
  .msg.ai .bubble a:hover { color: var(--accent-dark); border-bottom-color: var(--accent-dark); }
  .bubble strong { color: var(--accent-dark); }
  .bubble code { background: var(--accent-soft); color: var(--accent-dark); padding: 1px 6px; border-radius: 5px; font-family: var(--font-mono); font-size: 13px; }
  .bubble pre { background: var(--code-bg); color: #e2e8f0; padding: 12px; border-radius: 10px; overflow-x: auto; margin: 8px 0; font-family: var(--font-mono); font-size: 12.5px; line-height: 1.6; }

  /* ---------- 内联工具步骤 ---------- */
  .istep {
    display: inline-flex; align-items: center; gap: 7px; flex-wrap: wrap;
    padding: 6px 11px; border-radius: 9px; font-size: 12.5px;
    align-self: flex-start; max-width: 100%;
  }
  .istep-tool { background: #fef3c7; color: #92400e; }
  .istep-result { background: var(--accent-soft); color: var(--accent-dark); }
  .istep .q { font-family: var(--font-mono); font-size: 12px; }
  .istep .tag {
    background: #fff; padding: 1px 8px; border-radius: 6px;
    font-size: 11px; max-width: 220px; overflow: hidden;
    text-overflow: ellipsis; white-space: nowrap;
  }
  .istep .tlinks { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
  .istep .tlinks a {
    color: var(--accent); text-decoration: none; font-size: 11.5px;
    border: 1px solid rgba(2,132,199,.4); padding: 2px 9px; border-radius: 6px;
  }
  .istep .commit-id { margin-top: 6px; font-size: 11.5px; color: var(--muted); }
  .istep .commit-id code { background: var(--code-bg); color: #e2e8f0; padding: 2px 6px; font-family: var(--font-mono); border-radius: 5px; }

  /* ---------- 来源 ---------- */
  .sources { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .src {
    font-size: 11.5px; color: var(--accent-dark);
    background: var(--accent-soft);
    padding: 3px 10px; border-radius: 999px;
    text-decoration: none; max-width: 220px;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .src:hover { background: #d5eaf7; }
  .morebox { display: flex; flex-direction: column; gap: 6px; width: 100%; margin-top: 2px; }
  .more-toggle {
    align-self: flex-start;
    border: 1px solid var(--border); background: var(--panel); color: var(--accent);
    font-size: 11.5px; padding: 3px 11px; border-radius: 999px; cursor: pointer;
  }
  .more-toggle:hover { border-color: var(--accent); background: var(--accent-soft); }
  .more-toggle .mtri { font-size: 9px; margin-right: 2px; }
  .more-hidden { display: none; flex-wrap: wrap; gap: 6px; }
  .morebox.open .more-hidden { display: flex; }

  /* ---------- 建议问题 ---------- */
  .sug-box { margin-top: 10px; display: flex; flex-direction: column; gap: 6px; }
  .sug-label { font-size: 12px; color: var(--muted); margin-bottom: 2px; }
  .sug-chip {
    text-align: left;
    border: 1px solid var(--border); background: var(--panel); color: var(--fg);
    font-size: 13px; padding: 8px 13px; border-radius: 10px; cursor: pointer;
    transition: all .12s; font-family: var(--font-body);
  }
  .sug-chip:hover { background: var(--accent-soft); color: var(--accent-dark); border-color: rgba(2,132,199,.4); }

  /* ---------- 输入区 ---------- */
  footer {
    flex-shrink: 0;
    border-top: 1px solid var(--border);
    background: rgba(255,255,255,0.9);
    backdrop-filter: saturate(180%) blur(10px);
    padding: 14px 20px;
    transform: translateY(0);
    transition: transform .6s cubic-bezier(.22,1,.36,1);
  }
  .input-row {
    max-width: 820px; width: 100%; margin: 0 auto;
    display: flex; gap: 10px; align-items: flex-end;
  }
  #input {
    flex: 1;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 12px 16px;
    font-size: 15px;
    outline: none;
    font-family: var(--font-body);
    resize: none;
    background: var(--bg);
    line-height: 1.5;
    transition: border-color .15s, box-shadow .15s;
  }
  #input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(2,132,199,.12); }
  #send {
    background: var(--accent);
    color: #fff; border: none;
    border-radius: 14px;
    padding: 12px 24px;
    font-size: 15px; font-weight: 600; font-family: var(--font-body);
    cursor: pointer;
    transition: background .15s, transform .1s;
  }
  #send:hover { background: var(--accent-dark); }
  #send:active { transform: scale(.97); }
  #send:disabled { opacity: .5; cursor: not-allowed; }

  .typing::after { content: "▋"; animation: blink 1s steps(2) infinite; color: var(--accent); }
  @keyframes blink { 50% { opacity: 0; } }

  /* ---------- 空状态 ---------- */
  .empty {
    flex: 1; display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    color: var(--muted); gap: 8px; text-align: center;
    padding: 40px 0;
  }
  .empty .big {
    font-size: 44px; font-weight: 600;
    color: var(--accent); letter-spacing: -1px;
  }
  .empty h2 { color: var(--fg); font-size: 20px; font-weight: 600; }
  .empty > p { font-size: 14px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; justify-content: center; }
  .chip {
    border: 1px solid var(--border);
    background: #fff; padding: 9px 16px; border-radius: 999px;
    font-size: 13.5px; cursor: pointer; color: var(--fg);
    transition: all .12s;
  }
  .chip:hover { border-color: var(--accent); color: var(--accent-dark); background: var(--accent-soft); }

  /* ---------- 友链申请入口 ---------- */
  .friend-entry {
    margin-top: 26px;
    padding: 18px 22px;
    border: 1px dashed rgba(2,132,199,.5);
    background: var(--panel);
    border-radius: 14px;
    max-width: 380px;
    display: flex; flex-direction: column; align-items: center; gap: 10px;
  }
  .friend-title { font-weight: 600; font-size: 15px; color: var(--fg); }
  .friend-btn { background: var(--accent); color: #fff; border: none; font-weight: 600; }
  .friend-btn:hover { background: var(--accent-dark); color: #fff; }
  .friend-desc { font-size: 12px; color: var(--muted); line-height: 1.6; }

  @media (max-width: 640px) {
    .msg { max-width: 94%; }
    .msg.ai { max-width: 98%; }
    main { padding: 20px 14px; }
    .title { font-size: 15px; }
    .subtitle { display: none; }
  }
</style>
<!-- Cap 人机验证（本地静态资源，编程模式） -->
<script is:inline>
  window.CAP_CUSTOM_WASM_URL = '/cap/cap_wasm_bg.wasm';
</script>
<script src="/cap/cap.min.js" async></script>
<script src="/cap/cap-floating.min.js" async></script>
</head>
<body>
<header>
  <button class="back-btn" id="backBtn" aria-label="返回上一页" title="返回上一页">
    <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
  </button>
  <a class="brand" href="/">
    <img src={avatar} alt={siteTitle} />
    <span>{siteTitle}</span>
  </a>
  <nav class="dock-nav">
    {dockNav.map(n => (
      <a href={n.href} class="dock-item" data-label={n.name}>
        {n.name === '首页' ? (
          <svg class="w-5 h-5 text-current stroke-[2.2]" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        ) : n.name === '说说' ? (
          <svg class="w-5 h-5 text-current stroke-[2.2]" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        ) : n.name === '友链' ? (
          <svg class="w-5 h-5 text-current stroke-[2.2]" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        ) : n.name === '关于' ? (
          <svg class="w-5 h-5 text-current stroke-[2.2]" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        ) : n.name === '归档' ? (
          <svg class="w-5 h-5 text-current stroke-[2.2]" viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect width="20" height="5" x="2" y="3" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/></svg>
        ) : (
          <svg class="w-5 h-5 text-current stroke-[2.2]" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"/><circle cx="7" cy="7" r=".5" fill="currentColor"/></svg>
        )}
      </a>
    ))}
  </nav>
  <div class="badge" id="modelBadge">loading…</div>
  <button class="dock-btn flex items-center justify-center" id="themeToggle" title="切换主题" aria-label="切换主题">
    <svg class="w-4 h-4 stroke-[2.2]" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
  </button>
  <button class="dock-btn" id="clearBtn" title="清空对话">↺</button>
</header>

<main id="main">
  <div class="empty" id="emptyState">
    <div class="big flex items-center justify-center gap-2">
      <span>Hey</span>
      <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-[#9e2a2b]/10 dark:bg-[#d9534f]/20 text-[#9e2a2b] dark:text-[#d9534f] border border-[#9e2a2b]/30">
        <svg class="w-4 h-4 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3L12 3Z"/></svg>
      </span>
    </div>
    <h2>我是 AI 问答助手</h2>
    <p>可以回答关于本站博客文章的任何问题</p>
    <div class="chips">
      <div class="chip" data-q="本站主要分享什么内容">本站主要分享什么内容</div>
      <div class="chip" data-q="博主关注哪些领域">博主关注哪些领域</div>
      <div class="chip" data-q="最新文章速查">最新文章速查</div>
    </div>
    <div class="friend-entry" id="friendEntry">
      <div class="friend-title flex items-center justify-center gap-1.5">
        <svg class="w-4 h-4 text-[#9e2a2b] dark:text-[#d9534f] stroke-[2.2]" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <span>想和我交换友链？</span>
      </div>
      <button class="chip friend-btn" id="friendBtn">申请加友链</button>
      <div class="friend-desc">点击后 AI 会引导你完成申请，仅需网站链接和名称即可</div>
    </div>
  </div>
</main>

<footer>
  <div class="input-row">
    <textarea id="input" name="message" rows="1" placeholder="输入你想问的问题…" toolparamdescription="输入你想问的问题，AI 会基于博客文章内容回答"></textarea>
    <div class="send-wrap" style="position:relative; display:flex; align-items:flex-end;">
      <button id="send">发送</button>
    </div>
  </div>
</footer>

<script is:inline>
  const API_BASE = '';

  // 主题切换
  const themeToggle = document.getElementById('themeToggle');
  function applyTheme(dark){
    document.documentElement.classList.toggle('dark', dark);
    try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch(e){}
    if (themeToggle) {
      themeToggle.innerHTML = dark
        ? '<svg class="w-4 h-4 stroke-[2.2]" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>'
        : '<svg class="w-4 h-4 stroke-[2.2]" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>';
    }
  }
  (function(){ let d = false; try { d = localStorage.getItem('theme') === 'dark'; } catch(e){} applyTheme(d); })();
  if (themeToggle) themeToggle.addEventListener('click', () => applyTheme(!document.documentElement.classList.contains('dark')));

  // Cap 人机验证
  const CAP_API_ENDPOINT = '';
  let capFloatEl = null;
  let capTokenCache = '';
  async function ensureCapFloat(){
    if(!capFloatEl){
      capFloatEl = document.getElementById('capFloatWidget');
      if(capFloatEl){
        capFloatEl.addEventListener('solve', (e)=>{ capTokenCache = e.detail?.token || ''; });
        capFloatEl.addEventListener('reset', ()=>{ capTokenCache=''; });
      }
    }
    return capFloatEl;
  }
  async function solveCap(){
    await ensureCapFloat();
    if(!capFloatEl || !window.Cap) return '';
    capFloatEl.style.display = 'block';
    try{
      await capFloatEl.solve();
      await new Promise(r=>setTimeout(r,200));
    }catch(e){ console.warn('Cap solve error:', e); }
    capFloatEl.style.display = 'none';
    return capTokenCache;
  }

  const main = document.getElementById('main');
  const input = document.getElementById('input');
  const send = document.getElementById('send');
  const emptyState = document.getElementById('emptyState');
  const badge = document.getElementById('modelBadge');
  const composer = document.querySelector('footer');

  // 返回上一页
  const backBtn = document.getElementById('backBtn');
  if (backBtn) backBtn.addEventListener('click', () => { if (history.length > 1) history.back(); else window.location.href = '/'; });

  // 输入框「顶部 → 底部」移动动画
  let composerSettled = false;
  function raiseComposer(){
    if (composerSettled || !composer || !emptyState || emptyState.style.display === 'none') return;
    const eRect = emptyState.getBoundingClientRect();
    const cRect = composer.getBoundingClientRect();
    const gap = 28;
    const delta = (eRect.bottom + gap) - cRect.top;
    if (delta < 0) composer.style.transform = 'translateY(' + delta + 'px)';
  }
  function settleComposer(){
    if (composerSettled) return;
    composerSettled = true;
    if (composer) composer.style.transform = 'translateY(0)';
  }

  function autoGrow() { input.style.height='auto'; input.style.height=Math.min(input.scrollHeight,120)+'px'; }
  input.addEventListener('input', autoGrow);

  function esc(s){ return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

  function inline(text){
    let t = esc(text);
    t = t.replace(/\[([^\]]+)\]\(([^)]+)\)/g,'<a href="$2" target="_blank">$1</a>');
    t = t.replace(/(?<!=")(https?:\/\/[^\s<>")\]]+)/g, '<a href="$1" target="_blank">$1</a>');
    t = t.replace(/\*\*[ \t\u3000]*([\s\S]+?)[ \t\u3000]*\*\*/g, '<strong>$1</strong>');
    t = t.replace(/__([^\n_]+?)__/g, '<strong>$1</strong>');
    t = t.replace(/~~([^\n~]+?)~~/g, '<del>$1</del>');
    return t;
  }

  function renderMarkdown(text){
    if(!text) return '';
    const parts = text.split(/(```[\s\S]*?```)/g);
    let out = '';
    for(const part of parts){
      if(part.startsWith('```')){
        out += '<div class="mdcode">'+esc(part.replace(/```/g,''))+'</div>';
        continue;
      }
      out += renderLines(part);
    }
    return out;
  }

  function renderLines(text){
    const tableRe = /((?:^\|.*\|\s*$[\r\n]*)+)/gm;
    let html = '';
    const tableParts = text.split(tableRe);
    for(let pi=0; pi<tableParts.length; pi++){
      const part = tableParts[pi];
      if(part && part.trim().includes('|') && part.trim().split('\n').every(l => l.trim().startsWith('|') && l.trim().endsWith('|'))){
        html += renderTable(part);
      } else {
        html += renderLinesCore(part);
      }
    }
    return html;
  }

  function renderTable(block){
    const rows = block.split('\n').filter(l => l.trim().startsWith('|'));
    const row1IsSep = rows.length>1 && rows[1].split('|').slice(1,-1).every(c=>/^:?-{2,}:?$/.test(c.trim()));
    let t = '<table class="mdtable"><tbody>';
    rows.forEach((row, idx) => {
      const cells = row.split('|').slice(1, -1).map(c => c.trim());
      if(cells.every(c => /^:?-{2,}:?$/.test(c))) return;
      const cellTag = (idx===0 && row1IsSep) ? 'th' : 'td';
      t += '<tr>'+cells.map(c=>`<${cellTag}>${inline(c)}</${cellTag}>`).join('')+'</tr>';
    });
    t += '</tbody></table>';
    return t;
  }

  function renderLinesCore(text){
    const lines = text.split('\n');
    let html = '';
    let inList = false;
    let listTag = '';
    let plain = [];
    function closeList(){ if(inList){ html += '</'+listTag+'>'; inList=false; } }
    function flushPlain(){
      if(plain.length){
        html += '<div class="pseg">'+plain.map(inline).join('\n')+'</div>';
        plain = [];
      }
    }
    for(const raw of lines){
      const line = raw.trim();
      const headM = line.match(/^(#{1,4})\s+(.*)/);
      const listM = line.match(/^[-*•]\s+(.*)/);
      const numM = line.match(/^\d+[.)]\s+(.*)/);
      const quoteM = line.match(/^>\s?(.*)/);

      if(headM){ flushPlain(); closeList(); html += '<div class="mdh">'+inline(headM[2])+'</div>'; continue; }
      if(listM || numM){ flushPlain(); const tag = listM ? 'ul' : 'ol'; if(!inList || listTag!==tag){ closeList(); inList=true; listTag=tag; html+='<'+tag+'>'; } html += '<li>'+inline((listM||numM)[1])+'</li>'; continue; }
      if(quoteM){ flushPlain(); closeList(); html += '<div class="mdquote">'+inline(quoteM[1])+'</div>'; continue; }
      closeList();
      plain.push(raw);
    }
    flushPlain(); closeList();
    return html;
  }

  function addMsg(role, text){
    emptyState.style.display='none';
    const wrap=document.createElement('div');
    wrap.className='msg '+(role==='user'?'user':'ai');
    const b=document.createElement('div');
    b.className='bubble';
    if(role==='user') b.textContent=text;
    else b.innerHTML=renderMarkdown(text);
    wrap.appendChild(b);
    main.appendChild(wrap);
    main.scrollTop=main.scrollHeight;
    return wrap;
  }

  function addSources(wrap, sources){
    if(!sources||!sources.length) return;
    const SHOWN = 2;
    const row=document.createElement('div'); row.className='sources';
    const extra = sources.slice(SHOWN);
    const shown = sources.slice(0, SHOWN);
    shown.forEach(s=>{
      const a=document.createElement('a'); a.className='src';
      a.href=s.url; a.target='_blank'; a.textContent=s.title;
      row.appendChild(a);
    });
    if(extra.length){
      const more=document.createElement('div'); more.className='morebox';
      const toggle=document.createElement('button'); toggle.className='more-toggle';
      toggle.innerHTML='<span class="mtri">▸</span> +'+extra.length+' 篇';
      const hidden=document.createElement('div'); hidden.className='more-hidden';
      extra.forEach(s=>{
        const a=document.createElement('a'); a.className='src';
        a.href=s.url; a.target='_blank'; a.textContent=s.title;
        hidden.appendChild(a);
      });
      toggle.addEventListener('click',()=>{
        const open = more.classList.toggle('open');
        toggle.innerHTML = '<span class="mtri">'+(open?'▾':'▸')+'</span> '+(open?'收起':'+'+extra.length+' 篇');
        main.scrollTop=main.scrollHeight;
      });
      more.appendChild(toggle);
      more.appendChild(hidden);
      row.appendChild(more);
    }
    wrap.appendChild(row);
    main.scrollTop=main.scrollHeight;
  }

  function addSuggestions(wrap, suggestions){
    if(!suggestions || !suggestions.length) return;
    const MAXLEN = 24;
    const box=document.createElement('div'); box.className='sug-box';
    const label=document.createElement('div'); label.className='sug-label';
    label.innerHTML='<span class="inline-flex items-center gap-1"><svg class="w-3.5 h-3.5 text-amber-500 stroke-[2.2]" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg><span>你可以继续问：</span></span>';
    box.appendChild(label);
    suggestions.forEach(s=>{
      const chip=document.createElement('button'); chip.className='sug-chip';
      const full = s;
      const shown = full.length > MAXLEN ? full.slice(0, MAXLEN)+'…' : full;
      chip.textContent = shown;
      chip.title = full;
      chip.addEventListener('click',()=>sendQuestion(full));
      box.appendChild(chip);
    });
    wrap.appendChild(box);
    main.scrollTop=main.scrollHeight;
  }

  function inlineStep(bubble, kind, text){
    const p=document.createElement('div');
    p.className='istep istep-'+kind;
    p.innerHTML=text;
    bubble.appendChild(p);
    main.scrollTop=main.scrollHeight;
    return p;
  }

  let busy=false;
  const HISTORY_KEY = 'blog_ai_history';
  let chatHistory = [];
  try { chatHistory = JSON.parse(localStorage.getItem(HISTORY_KEY) || '[]') || []; } catch(e){ chatHistory = []; }
  function saveHistory(){
    try{ localStorage.setItem(HISTORY_KEY, JSON.stringify(chatHistory.slice(-24))); }catch(e){}
  }

  async function sendQuestion(q){
    if(busy) return;
    q=(q||input.value).trim();
    if(!q) return;
    input.value=''; autoGrow();
    busy=true; send.disabled=true;
    settleComposer();
    addMsg('user', q);

    const aiWrap=addMsg('ai','');
    const bubble=aiWrap.querySelector('.bubble');
    bubble.classList.add('typing');

    const flow=document.createElement('div');
    flow.className='flow';
    bubble.appendChild(flow);
    let currentEl=null;
    let accumulated='';
    let thinkingBuf='';

    let thinkBox=null, thinkBodyEl=null, thinkHeadEl=null, thinkOpen=false;

    function ensureTextEl(){
      if(!currentEl || currentEl._isThink){
        currentEl=document.createElement('div');
        currentEl.className='ansbox';
        currentEl._isThink=false;
        flow.appendChild(currentEl);
      }
      return currentEl;
    }
    function renderAccum(){
      ensureTextEl().textContent = accumulated;
      main.scrollTop=main.scrollHeight;
    }
    function initThinkBox(){
      if(thinkBox) return;
      thinkBox=document.createElement('div');
      thinkBox.className='think-box';
      thinkHeadEl=document.createElement('div');
      thinkHeadEl.className='think-head';
      thinkHeadEl.innerHTML='<span class="think-label inline-flex items-center gap-1.5"><svg class="w-3.5 h-3.5 animate-spin shrink-0 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10" stroke-dasharray="32" stroke-dashoffset="12"/></svg><span>思考中</span></span>';
      thinkBodyEl=document.createElement('div');
      thinkBodyEl.className='think-body';
      thinkBox.appendChild(thinkHeadEl);
      thinkBox.appendChild(thinkBodyEl);
      flow.appendChild(thinkBox);
      thinkHeadEl.addEventListener('click',()=>toggleThink());
    }
    function renderThinkingEl(){
      initThinkBox();
      thinkOpen=true;
      thinkBox.classList.add('open');
      thinkHeadEl.querySelector('.think-label').innerHTML='<svg class="w-3.5 h-3.5 animate-spin shrink-0 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10" stroke-dasharray="32" stroke-dashoffset="12"/></svg><span>思考中</span>';
      thinkBodyEl.textContent = thinkingBuf;
      main.scrollTop=main.scrollHeight;
    }
    function toggleThink(){
      thinkOpen=!thinkOpen;
      thinkBox.classList.toggle('open', thinkOpen);
    }
    function closeThinking(){
      if(thinkBox){
        thinkOpen=false;
        thinkBox.classList.remove('open');
        thinkHeadEl.querySelector('.think-label').innerHTML='<svg class="w-3.5 h-3.5 shrink-0 stroke-[2.2]" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 2a4.5 4.5 0 0 0-4.5 4.5c0 .77.2 1.49.54 2.12A4.5 4.5 0 0 0 4 13a4.5 4.5 0 0 0 3 4.24V18a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2v-.76A4.5 4.5 0 0 0 20 13a4.5 4.5 0 0 0-4.04-4.38 4.5 4.5 0 0 0 .54-2.12A4.5 4.5 0 0 0 12 2Z"/></svg><span>已思考（点击展开）</span>';
      }
    }

    try{
      let capToken = '';
      try { capToken = await solveCap(); } catch(e){ console.warn('Cap solve fail:', e); }
      const res=await fetch(API_BASE+'/api/chat/stream',{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({question:q, history: chatHistory.slice(-12), 'cap-token': capToken})
      });
      if(!res.ok||!res.body){
        let msg = 'HTTP '+res.status;
        try { const j = await res.json(); if(j.error) msg = j.error; } catch(e){}
        throw new Error(msg);
      }
      bubble.classList.remove('typing');

      const reader=res.body.getReader();
      const decoder=new TextDecoder();
      let buffer='';

      while(true){
        const {done,value}=await reader.read();
        if(done) break;
        buffer+=decoder.decode(value,{stream:true});
        let idx;
        while((idx=buffer.indexOf('\n\n'))!==-1){
          const block=buffer.slice(0,idx);
          buffer=buffer.slice(idx+2);
          const lines=block.split('\n');
          let event='delta', data='';
          for(const ln of lines){
            if(ln.startsWith('event:')) event=ln.slice(6).trim();
            else if(ln.startsWith('data:')) data+=ln.slice(5).trim();
          }
          if(!data) continue;

          if(event==='thinking'){
            let d; try{ d = JSON.parse(data); }catch(e){ d = data; }
            thinkingBuf += d;
            renderThinkingEl();
          }
          else if(event==='delta'){
            let d; try{ d = JSON.parse(data); }catch(e){ d = data; }
            closeThinking();
            accumulated += d; renderAccum();
          }
          else if(event==='tool'){
            try{
              const t=JSON.parse(data);
              closeThinking();
              currentEl=null; accumulated='';
              if(t.name==='fetch_web'){
                inlineStep(flow,'tool','<span class="inline-flex items-center gap-1 font-bold"><svg class="w-3.5 h-3.5 stroke-[2.2]" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>抓取网站</span> '+esc(t.url||''));
              } else if(t.name==='add_friend'){
                inlineStep(flow,'tool','<span class="inline-flex items-center gap-1 font-bold"><svg class="w-3.5 h-3.5 stroke-[2.2]" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/></svg>添加友链</span> '+esc((t.friendName||'')+(t.url?' · '+t.url:'')));
              } else {
                inlineStep(flow,'tool','<span class="inline-flex items-center gap-1 font-bold"><svg class="w-3.5 h-3.5 stroke-[2.2]" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10"/><path d="M6 10h10"/></svg>读取文章</span>');
              }
            }catch(e){}
          }
          else if(event==='tool_result'){
            try{
              const m=JSON.parse(data);
              currentEl=null; accumulated='';
              if(m.kind==='fetch'){
                const parts=['<span class="inline-flex items-center gap-1 font-bold text-emerald-600 dark:text-emerald-400"><svg class="w-3.5 h-3.5 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>网站抓取成功</span>'];
                if(m.title) parts.push('<span class="tag">'+esc(m.title)+'</span>');
                if(m.error) inlineStep(flow,'result','<span class="inline-flex items-center gap-1 font-bold text-red-600 dark:text-red-400"><svg class="w-3.5 h-3.5 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>'+esc(m.error)+'</span>');
                else {
                  if(m.links&&m.links.length) parts.push('<div class="tlinks">'+m.links.map(l=>'<a href="'+esc(l)+'" target="_blank">'+esc(l)+'</a>').join('')+'</div>');
                  inlineStep(flow,'result', parts.join(' '));
                }
              } else if(m.kind==='add_friend'){
                const ok = m.ok;
                const statusIcon = ok
                  ? '<svg class="w-3.5 h-3.5 stroke-[2.5] text-emerald-600 dark:text-emerald-400 inline-block mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>'
                  : '<svg class="w-3.5 h-3.5 stroke-[2.5] text-red-600 dark:text-red-400 inline-block mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>';
                let html = '<span class="font-bold inline-flex items-center">'+statusIcon+esc(m.message||'')+'</span>';
                if(ok && m.commit_id){
                  html += '<div class="commit-id">Commit: <code>'+esc(m.commit_id)+'</code></div>';
                }
                if(ok && m.verify){
                  const v=m.verify;
                  let vh='';
                  if(v.home_title) vh+='<span class="tag inline-flex items-center gap-1"><svg class="w-3 h-3 stroke-[2.2]" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>'+esc(v.home_title)+'</span>';
                  if(v.article_titles) vh+=v.article_titles.slice(0,3).map(t=>'<span class="tag inline-flex items-center gap-1"><svg class="w-3 h-3 stroke-[2.2]" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>'+esc(t)+'</span>').join('');
                  if(v.rss_preview) vh+='<span class="tag inline-flex items-center gap-1"><svg class="w-3 h-3 stroke-[2.2]" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>RSS 已验证</span>';
                  if(vh) html += '<div class="tlinks">'+vh+'</div>';
                }
                inlineStep(flow,'result', html);
              } else {
                const tags=(m.titles||[]).map(t=>'<span class="tag">'+esc(t)+'</span>').join('');
                inlineStep(flow,'result','<span class="inline-flex items-center gap-1 font-bold text-emerald-600 dark:text-emerald-400"><svg class="w-3.5 h-3.5 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>已读取 '+(m.count||0)+' 篇</span> '+tags);
              }
            }catch(e){}
          }
          else if(event==='tool_done'){
            try{
              const m=JSON.parse(data);
              if(m.sources&&m.sources.length) addSources(aiWrap, m.sources);
            }catch(e){}
          }
          else if(event==='error'){
            try{ ensureTextEl().innerHTML='<span class="inline-flex items-center gap-1 text-red-500 font-bold"><svg class="w-4 h-4 stroke-[2.2]" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>'+esc(JSON.parse(data).error)+'</span>'; }catch(e){}
          }
        }
      }
      closeThinking();
      if(accumulated.trim()){
        ensureTextEl().innerHTML = renderMarkdown(accumulated);
      }
      if(accumulated.trim()){
        chatHistory.push({role:'user', content:q});
        chatHistory.push({role:'assistant', content:accumulated});
        saveHistory();
      }
      if(accumulated===''&&!flow.textContent.trim()) ensureTextEl().innerHTML='<span class="inline-flex items-center gap-1 text-slate-400 font-bold"><svg class="w-4 h-4 stroke-[2.2]" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>没有返回内容</span>';

      if(accumulated.trim()){
        const answerText = accumulated;
        (async()=>{
          let capToken = '';
          try { capToken = await solveCap(); } catch(e){}
          fetch(API_BASE+'/api/suggest',{
            method:'POST', headers:{'Content-Type':'application/json'},
            body: JSON.stringify({question:q, answer: answerText.slice(0,1500), 'cap-token': capToken})
          })
          .then(r=>r.json())
          .then(d=>{ if(d && d.suggestions && d.suggestions.length) addSuggestions(aiWrap, d.suggestions); })
          .catch(()=>{});
        })();
      }
    }catch(e){
      bubble.classList.remove('typing');
      ensureTextEl().innerHTML='<span class="inline-flex items-center gap-1 text-red-500 font-bold"><svg class="w-4 h-4 stroke-[2.2]" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>请求失败：'+esc(e.message)+'</span>';
    }finally{
      busy=false; send.disabled=false; input.focus();
    }
  }

  send.addEventListener('click',()=>sendQuestion());
  input.addEventListener('keydown',e=>{
    if(e.key==='Enter'&&!e.shiftKey){ e.preventDefault(); sendQuestion(); }
  });
  document.querySelectorAll('.chip').forEach(c=>{
    c.addEventListener('click',()=>sendQuestion(c.dataset.q));
  });

  fetch(API_BASE+'/api/articles').then(r=>r.json()).then(d=>{
    badge.textContent='共 '+d.total+' 篇文章';
  });

  function restoreHistory(){
    if(!chatHistory.length) return;
    emptyState.style.display='none';
    settleComposer();
    for(const h of chatHistory){
      if(h.role==='user'){
        addMsg('user', h.content);
      } else {
        const wrap=addMsg('ai','');
        const b=wrap.querySelector('.bubble');
        b.innerHTML=renderMarkdown(h.content);
      }
    }
    main.scrollTop=main.scrollHeight;
  }
  restoreHistory();
  if (!chatHistory.length) raiseComposer();

  // 访问 /ai/friend 时自动触发友链申请介绍
  if(window.location.pathname.endsWith('/friend')){
    addMsg('user','我想申请友链，介绍一下怎么添加');
    setTimeout(()=>sendQuestion('我想申请交换友链，请问需要提供哪些信息？'), 300);
  }

  const friendBtn = document.getElementById('friendBtn');
  if(friendBtn){
    friendBtn.addEventListener('click',()=>{
      addMsg('user','我想申请友链，介绍一下怎么添加');
      setTimeout(()=>sendQuestion('我想申请交换友链，请问需要提供哪些信息？'), 200);
    });
  }

  document.getElementById('clearBtn').addEventListener('click',()=>{
    chatHistory=[];
    saveHistory();
    main.innerHTML='';
    main.appendChild(emptyState);
    emptyState.style.display='flex';
    composerSettled = false;
    composer.style.transform = '';
    requestAnimationFrame(()=>raiseComposer());
  });

  window.addEventListener('resize', ()=>{ if(!composerSettled) raiseComposer(); });
</script>
</body>
</html>
