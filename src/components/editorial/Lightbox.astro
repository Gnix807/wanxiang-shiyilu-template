---
---

<div id="editorial-lightbox" class="editorial-lightbox" role="dialog" aria-modal="true" aria-hidden="true">
  <!-- 沉浸式暗黑遮罩 -->
  <div class="lightbox-backdrop" id="lightbox-backdrop" title="点击背景关闭 (Esc)"></div>

  <!-- 悬浮顶栏：计数、缩放切换与极简关闭按纽 -->
  <header class="lightbox-header">
    <div class="lightbox-counter font-mono" id="lightbox-counter">1 / 1</div>
    <div class="lightbox-actions">
      <button type="button" class="lightbox-icon-btn" id="lightbox-zoom-btn" aria-label="放大图片" title="缩放图片 (点击图片或滚轮)">
        <svg class="icon-zoom-in" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          <line x1="11" y1="8" x2="11" y2="14"></line>
          <line x1="8" y1="11" x2="14" y2="11"></line>
        </svg>
        <svg class="icon-zoom-out" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          <line x1="8" y1="11" x2="14" y2="11"></line>
        </svg>
      </button>

      <button type="button" class="lightbox-icon-btn" id="lightbox-close-btn" aria-label="关闭灯箱 (Esc)" title="关闭 (Esc)">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </header>

  <!-- 左右切换按纽 (仅在多图且非缩放态时显示) -->
  <button type="button" id="lightbox-prev-btn" class="lightbox-nav-btn prev" aria-label="上一张 (←)" title="上一张 (←)">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="15 18 9 12 15 6"></polyline>
    </svg>
  </button>

  <button type="button" id="lightbox-next-btn" class="lightbox-nav-btn next" aria-label="下一张 (→)" title="下一张 (→)">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="9 18 15 12 9 6"></polyline>
    </svg>
  </button>

  <!-- 核心视窗：支持拖拽平移与多级缩放的展陈舞台 -->
  <main class="lightbox-main" id="lightbox-main">
    <div class="lightbox-stage" id="lightbox-stage">
      <img id="lightbox-active-img" class="lightbox-img" src="" alt="" draggable="false" />
    </div>
    <figcaption class="lightbox-caption" id="lightbox-caption-text"></figcaption>
  </main>
</div>

<style>
  /* 现代主流大厂标准灯箱规范 (对标 PhotoSwipe / Unsplash / Twitter / Medium) */
  .editorial-lightbox {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  .editorial-lightbox.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* 纯黑深邃背景与 12px 视网膜毛玻璃高斯模糊 */
  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    cursor: zoom-out;
  }

  /* 极简悬浮顶栏 */
  .lightbox-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 64px;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 30;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .lightbox-counter {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 13px;
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 1px;
    pointer-events: auto;
    user-select: none;
  }

  .lightbox-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    pointer-events: auto;
  }

  .lightbox-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.08);
    border: none;
    border-radius: 50%;
    color: rgba(255, 255, 255, 0.85);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }

  .lightbox-icon-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    color: #ffffff;
    transform: scale(1.06);
  }

  .lightbox-icon-btn:active {
    transform: scale(0.94);
  }

  /* 核心主体展陈 */
  .lightbox-main {
    position: relative;
    z-index: 10;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    overflow: hidden;
    user-select: none;
  }

  .lightbox-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 68px 80px 48px;
    box-sizing: border-box;
    cursor: zoom-out;
  }

  /* 图片本身：默认适应视口，点击后放大并支持拖拽 */
  .lightbox-img {
    display: block;
    max-width: 100%;
    max-height: calc(100vh - 140px);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 2px;
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.7);
    cursor: zoom-in;
    user-select: none;
    -webkit-user-drag: none;
    transform-origin: center center;
    will-change: transform;
    transition: transform 0.24s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
  }

  /* 放大与拖拽状态 */
  .editorial-lightbox.is-zoomed .lightbox-img {
    cursor: grab;
    max-width: none;
    max-height: none;
  }

  .editorial-lightbox.is-zoomed.is-dragging .lightbox-img {
    cursor: grabbing;
    transition: none !important;
  }

  /* 放大时图说与翻页按钮淡出，保证全屏沉浸看图 */
  .editorial-lightbox.is-zoomed .lightbox-caption,
  .editorial-lightbox.is-zoomed .lightbox-nav-btn {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  /* 简要图说文字：纯净居中，柔和清晰 */
  .lightbox-caption {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 13.5px;
    font-weight: 400;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.75);
    max-width: 640px;
    text-align: center;
    user-select: text;
    cursor: default;
    z-index: 20;
    transition: opacity 0.2s ease;
    pointer-events: none;
  }

  .lightbox-caption:empty {
    display: none;
  }

  /* 左右切换箭头 */
  .lightbox-nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    border: none;
    color: rgba(255, 255, 255, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 25;
    transition: background-color 0.15s ease, color 0.15s ease, transform 0.15s ease, opacity 0.2s ease;
  }

  .lightbox-nav-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    color: #ffffff;
    transform: translateY(-50%) scale(1.08);
  }

  .lightbox-nav-btn:active {
    transform: translateY(-50%) scale(0.94);
  }

  .lightbox-nav-btn.prev {
    left: 20px;
  }

  .lightbox-nav-btn.next {
    right: 20px;
  }

  @media (max-width: 768px) {
    .lightbox-header {
      padding: 0 16px;
      height: 56px;
    }
    .lightbox-stage {
      padding: 56px 16px 32px;
    }
    .lightbox-img {
      max-height: calc(100vh - 120px);
    }
    .lightbox-nav-btn {
      width: 40px;
      height: 40px;
    }
    .lightbox-nav-btn.prev {
      left: 10px;
    }
    .lightbox-nav-btn.next {
      right: 10px;
    }
  }

  /* 正文中可放大图片的现代平滑光标与悬停感 */
  :global(.article-content img:not(.no-zoom):not(.inline-icon):not(.avatar)),
  :global(.editorial-plate img),
  :global(.editorial-image-grid img),
  :global(img[data-zoomable]) {
    cursor: zoom-in !important;
    transition: opacity 0.18s ease;
  }

  :global(.article-content img:not(.no-zoom):not(.inline-icon):not(.avatar):hover),
  :global(.editorial-plate img:hover),
  :global(.editorial-image-grid img:hover),
  :global(img[data-zoomable]:hover) {
    opacity: 0.92;
  }
</style>

<script>
  interface GalleryItem {
    el: HTMLImageElement;
    src: string;
    alt: string;
    caption: string;
  }

  function initEditorialLightbox() {
    const lightbox = document.getElementById('editorial-lightbox');
    const activeImg = document.getElementById('lightbox-active-img') as HTMLImageElement | null;
    const stage = document.getElementById('lightbox-stage');
    const captionEl = document.getElementById('lightbox-caption-text');
    const counterEl = document.getElementById('lightbox-counter');
    const prevBtn = document.getElementById('lightbox-prev-btn');
    const nextBtn = document.getElementById('lightbox-next-btn');
    const closeBtn = document.getElementById('lightbox-close-btn');
    const zoomBtn = document.getElementById('lightbox-zoom-btn');
    const zoomInIcon = zoomBtn?.querySelector('.icon-zoom-in') as HTMLElement | null;
    const zoomOutIcon = zoomBtn?.querySelector('.icon-zoom-out') as HTMLElement | null;
    const backdrop = document.getElementById('lightbox-backdrop');

    if (!lightbox || !activeImg || !stage) return;

    let gallery: GalleryItem[] = [];
    let currentIndex = 0;

    // 缩放与平移状态机
    let zoomLevel = 1;
    let panX = 0;
    let panY = 0;
    let isDragging = false;
    let dragStartX = 0;
    let dragStartY = 0;
    let initialPanX = 0;
    let initialPanY = 0;
    let hasMoved = false;

    function resetZoom(animated = true) {
      zoomLevel = 1;
      panX = 0;
      panY = 0;
      lightbox!.classList.remove('is-zoomed', 'is-dragging');
      if (zoomInIcon && zoomOutIcon) {
        zoomInIcon.style.display = 'block';
        zoomOutIcon.style.display = 'none';
      }
      if (activeImg) {
        if (!animated) activeImg.style.transition = 'none';
        activeImg.style.transform = 'translate3d(0, 0, 0) scale(1)';
        if (!animated) {
          // 强制回流后恢复过渡
          activeImg.offsetHeight;
          activeImg.style.transition = '';
        }
      }
    }

    function applyTransform(animated = true) {
      if (!activeImg) return;
      if (!animated) {
        activeImg.style.transition = 'none';
      } else {
        activeImg.style.transition = 'transform 0.24s cubic-bezier(0.16, 1, 0.3, 1)';
      }
      activeImg.style.transform = `translate3d(${panX}px, ${panY}px, 0) scale(${zoomLevel})`;
    }

    function setZoom(newZoom: number, originX?: number, originY?: number) {
      const prevZoom = zoomLevel;
      zoomLevel = Math.max(1, Math.min(4, newZoom));

      if (zoomLevel === 1) {
        resetZoom(true);
        return;
      }

      lightbox!.classList.add('is-zoomed');
      if (zoomInIcon && zoomOutIcon) {
        zoomInIcon.style.display = 'none';
        zoomOutIcon.style.display = 'block';
      }

      // 如果提供了聚焦原点（如用户点击的位置），使该位置向中心对齐
      if (originX !== undefined && originY !== undefined && prevZoom === 1) {
        const rect = activeImg!.getBoundingClientRect();
        const offsetX = originX - (rect.left + rect.width / 2);
        const offsetY = originY - (rect.top + rect.height / 2);
        panX = -offsetX * (zoomLevel - 1);
        panY = -offsetY * (zoomLevel - 1);
      }

      clampPan();
      applyTransform(true);
    }

    function toggleZoom(originX?: number, originY?: number) {
      if (zoomLevel > 1) {
        resetZoom(true);
      } else {
        // 放大至 2.2 倍体验极佳
        setZoom(2.2, originX, originY);
      }
    }

    // 边界限制：防止图片被拖出屏幕可见区域
    function clampPan() {
      if (!activeImg || zoomLevel <= 1) {
        panX = 0;
        panY = 0;
        return;
      }
      const rect = activeImg.getBoundingClientRect();
      const scaledW = (rect.width / (zoomLevel > 1 ? zoomLevel : 1)) * zoomLevel;
      const scaledH = (rect.height / (zoomLevel > 1 ? zoomLevel : 1)) * zoomLevel;

      const maxX = Math.max(0, (scaledW - window.innerWidth) / 2 + 60);
      const maxY = Math.max(0, (scaledH - window.innerHeight) / 2 + 60);

      panX = Math.max(-maxX, Math.min(maxX, panX));
      panY = Math.max(-maxY, Math.min(maxY, panY));
    }

    // 扫描页面中可放大的图片
    function scanImages() {
      const selector = [
        '.article-content img:not(.no-zoom):not(.inline-icon):not(.avatar)',
        '.editorial-plate img',
        '.editorial-image-grid img',
        'img[data-zoomable]'
      ].join(', ');

      const imgElements = Array.from(document.querySelectorAll<HTMLImageElement>(selector));
      gallery = [];

      imgElements.forEach((img) => {
        if (img.closest('a:not([data-zoomable])') && !img.closest('.editorial-plate') && !img.closest('.editorial-image-grid')) return;

        let caption = '';
        const figure = img.closest('figure');
        if (figure) {
          const figcap = figure.querySelector('figcaption');
          if (figcap) caption = figcap.textContent?.trim() || '';
        }
        if (!caption) {
          caption = img.getAttribute('data-caption') || img.alt || img.title || '';
        }

        const src = img.getAttribute('data-zoom-src') || img.currentSrc || img.src;
        if (!src) return;

        const item: GalleryItem = {
          el: img,
          src,
          alt: img.alt || '图版',
          caption
        };

        const idx = gallery.length;
        gallery.push(item);

        img.onclick = (e) => {
          e.preventDefault();
          e.stopPropagation();
          openLightbox(idx);
        };
      });
    }

    function openLightbox(index: number) {
      if (!gallery[index]) return;
      currentIndex = index;
      resetZoom(false);
      renderItem();
      lightbox!.classList.add('is-active');
      lightbox!.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      resetZoom(false);
      lightbox!.classList.remove('is-active');
      lightbox!.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (activeImg) {
        activeImg.src = '';
      }
    }

    function renderItem() {
      const item = gallery[currentIndex];
      if (!item || !activeImg) return;

      resetZoom(false);
      activeImg.src = item.src;
      activeImg.alt = item.alt;

      if (captionEl) {
        captionEl.textContent = item.caption || '';
      }

      // 仅当多图时显示计数器与左右箭头；单张图片时不出现任何干扰元素（主流大厂规范）
      const isMulti = gallery.length > 1;
      if (counterEl) {
        counterEl.style.display = isMulti ? 'block' : 'none';
        if (isMulti) {
          counterEl.textContent = `${currentIndex + 1} / ${gallery.length}`;
        }
      }

      if (prevBtn && nextBtn) {
        prevBtn.style.display = isMulti ? 'flex' : 'none';
        nextBtn.style.display = isMulti ? 'flex' : 'none';
      }
    }

    function prev() {
      if (gallery.length <= 1) return;
      currentIndex = (currentIndex - 1 + gallery.length) % gallery.length;
      renderItem();
    }

    function next() {
      if (gallery.length <= 1) return;
      currentIndex = (currentIndex + 1) % gallery.length;
      renderItem();
    }

    // 1. 点击图片：未放大时点击放大到点击点；已放大时无位移点击还原
    activeImg.addEventListener('mousedown', (e) => {
      if (e.button !== 0) return; // 仅处理左键
      isDragging = true;
      hasMoved = false;
      dragStartX = e.clientX;
      dragStartY = e.clientY;
      initialPanX = panX;
      initialPanY = panY;

      if (zoomLevel > 1) {
        lightbox!.classList.add('is-dragging');
        e.preventDefault();
      }
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      const dx = e.clientX - dragStartX;
      const dy = e.clientY - dragStartY;

      if (Math.abs(dx) > 4 || Math.abs(dy) > 4) {
        hasMoved = true;
      }

      if (zoomLevel > 1) {
        panX = initialPanX + dx;
        panY = initialPanY + dy;
        clampPan();
        applyTransform(false);
      }
    });

    window.addEventListener('mouseup', (e) => {
      if (!isDragging) return;
      isDragging = false;
      lightbox!.classList.remove('is-dragging');

      // 如果鼠标在图片上点击且没有发生拖拽，执行缩放切换
      if (!hasMoved && (e.target === activeImg)) {
        toggleZoom(e.clientX, e.clientY);
      } else if (zoomLevel > 1) {
        // 拖拽释放后带回弹动画吸附到合法边界
        clampPan();
        applyTransform(true);
      }
    });

    // 滚轮直接缩放（以鼠标指针为中心，PhotoSwipe / Figma 级平滑体验）
    stage.addEventListener('wheel', (e) => {
      e.preventDefault();
      const zoomFactor = e.deltaY < 0 ? 1.25 : 0.8;
      const targetZoom = zoomLevel * zoomFactor;

      if (targetZoom < 1.05) {
        resetZoom(true);
      } else {
        setZoom(targetZoom, e.clientX, e.clientY);
      }
    }, { passive: false });

    // 点击顶栏缩放按钮
    zoomBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleZoom();
    });

    // 点击关闭按钮或黑色背景空白区域直接退出
    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeLightbox();
    });

    backdrop?.addEventListener('click', () => {
      closeLightbox();
    });

    stage.addEventListener('click', (e) => {
      // 点击图片之外的留白区域退出
      if (e.target === stage) {
        closeLightbox();
      }
    });

    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      prev();
    });

    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      next();
    });

    // 键盘支持 (Esc, ArrowLeft, ArrowRight, +, -, 0)
    document.addEventListener('keydown', (e) => {
      if (!lightbox!.classList.contains('is-active')) return;

      if (e.key === 'Escape') {
        if (zoomLevel > 1) {
          resetZoom(true);
        } else {
          closeLightbox();
        }
      } else if (e.key === 'ArrowLeft' && zoomLevel === 1) {
        prev();
      } else if (e.key === 'ArrowRight' && zoomLevel === 1) {
        next();
      } else if (e.key === '+' || e.key === '=') {
        setZoom(zoomLevel * 1.3);
      } else if (e.key === '-' || e.key === '_') {
        setZoom(zoomLevel / 1.3);
      } else if (e.key === '0' || e.key === 'r' || e.key === 'R') {
        resetZoom(true);
      }
    });

    // 移动端双指 Pinch 缩放与单指滑动
    let initialTouchDist = 0;
    let initialTouchZoom = 1;
    let touchStartX = 0;
    let touchStartY = 0;

    stage.addEventListener('touchstart', (e) => {
      if (e.touches.length === 2) {
        // 双指捏合起始
        initialTouchDist = Math.hypot(
          e.touches[0].clientX - e.touches[1].clientX,
          e.touches[0].clientY - e.touches[1].clientY
        );
        initialTouchZoom = zoomLevel;
      } else if (e.touches.length === 1) {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
        dragStartX = touchStartX;
        dragStartY = touchStartY;
        initialPanX = panX;
        initialPanY = panY;
        hasMoved = false;
      }
    }, { passive: true });

    stage.addEventListener('touchmove', (e) => {
      if (e.touches.length === 2 && initialTouchDist > 0) {
        const dist = Math.hypot(
          e.touches[0].clientX - e.touches[1].clientX,
          e.touches[0].clientY - e.touches[1].clientY
        );
        const factor = dist / initialTouchDist;
        setZoom(initialTouchZoom * factor);
      } else if (e.touches.length === 1 && zoomLevel > 1) {
        const dx = e.touches[0].clientX - dragStartX;
        const dy = e.touches[0].clientY - dragStartY;
        panX = initialPanX + dx;
        panY = initialPanY + dy;
        clampPan();
        applyTransform(false);
      }
    }, { passive: true });

    stage.addEventListener('touchend', (e) => {
      if (e.touches.length === 0) {
        if (zoomLevel <= 1) {
          // 单张模式下滑动切图或下滑退出
          const diffX = e.changedTouches[0].clientX - touchStartX;
          const diffY = e.changedTouches[0].clientY - touchStartY;
          if (Math.abs(diffX) > 50 && Math.abs(diffX) > Math.abs(diffY)) {
            if (diffX > 0) prev();
            else next();
          } else if (diffY > 80 && Math.abs(diffY) > Math.abs(diffX)) {
            closeLightbox();
          }
        } else {
          clampPan();
          applyTransform(true);
        }
      }
    }, { passive: true });

    scanImages();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEditorialLightbox);
