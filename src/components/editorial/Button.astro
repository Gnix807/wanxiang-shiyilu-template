---
import { ExternalLink } from 'lucide-astro';

interface Props {
  href?: string;
  target?: string;
  variant?: 'primary' | 'seal' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  text?: string;
  className?: string;
}

const {
  href,
  target,
  variant = 'outline',
  size = 'md',
  text,
  className = '',
} = Astro.props;

const isExternal = target === '_blank' || (href && /^https?:\/\//.test(href));
---

{
  href ? (
    <a
      href={href}
      target={target || (isExternal ? '_blank' : undefined)}
      rel={isExternal ? 'noopener noreferrer' : undefined}
      class={`editorial-button variant-${variant} size-${size} font-sans ${className}`}
    >
      <span class="button-label">
        {text ? text : <slot />}
      </span>
      {isExternal && <ExternalLink size={12} stroke-width={2} class="button-icon" />}
    </a>
  ) : (
    <button type="button" class={`editorial-button variant-${variant} size-${size} font-sans ${className}`}>
      <span class="button-label">
        {text ? text : <slot />}
      </span>
    </button>
  )
}

<style>
  .editorial-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-weight: 800;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    cursor: pointer;
    text-decoration: none;
    position: relative;
    user-select: none;
    vertical-align: middle;
    line-height: 1;
    transition: transform 0.15s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.15s cubic-bezier(0.16, 1, 0.3, 1), color 0.15s ease, border-color 0.15s ease;
  }

  .button-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .size-sm {
    font-size: 11.5px;
    padding: 5px 12px;
  }

  .size-md {
    font-size: 13.5px;
    padding: 8px 18px;
  }

  .size-lg {
    font-size: 15px;
    padding: 11px 24px;
  }

  /* Seal 风格（金石朱砂印） */
  .variant-seal {
    background: var(--press-red);
    color: #ffffff !important;
    border: 2px solid var(--line-solid);
    border-radius: 0;
    box-shadow: 3px 3px 0 var(--line-solid);
  }

  .variant-seal:hover {
    transform: translate(-1.5px, -1.5px);
    background: #b53032;
    box-shadow: 4.5px 4.5px 0 var(--line-solid);
  }

  .variant-seal:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 var(--line-solid);
  }

  /* Outline 风格（传统出版物外框按纽） */
  .variant-outline {
    background: var(--paper-surface);
    color: var(--ink-text);
    border: 2px solid var(--line-solid);
    border-radius: 0;
    box-shadow: 3px 3px 0 var(--line-solid);
  }

  .variant-outline:hover {
    color: var(--press-red);
    border-color: var(--press-red);
    background: var(--press-red-soft);
    transform: translate(-1.5px, -1.5px);
    box-shadow: 4.5px 4.5px 0 var(--press-red);
  }

  .variant-outline:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 var(--press-red);
  }

  /* Primary 风格（沉墨重磅出版按纽） */
  .variant-primary {
    background: var(--ink-text);
    color: var(--paper-bg) !important;
    border: 2px solid var(--line-solid);
    border-radius: 0;
    box-shadow: 3px 3px 0 var(--press-red);
  }

  .variant-primary:hover {
    transform: translate(-1.5px, -1.5px);
    box-shadow: 4.5px 4.5px 0 var(--press-red);
  }

  .variant-primary:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 var(--press-red);
  }

  /* Ghost 风格（文人隐式按纽） */
  .variant-ghost {
    background: transparent;
    color: var(--ink-text);
    border: 1.5px solid transparent;
    border-radius: 0;
    box-shadow: none;
  }

  .variant-ghost:hover {
    color: var(--press-red);
    background: var(--paper-surface);
    border-color: var(--line-solid);
    transform: translate(-1px, -1px);
    box-shadow: 2.5px 2.5px 0 var(--line-solid);
  }

  .variant-ghost:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0 var(--line-solid);
  }

  .button-icon {
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  .editorial-button:hover .button-icon {
    transform: translate(1px, -1px);
  }
</style>
