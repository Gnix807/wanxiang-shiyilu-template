---
interface Props {
  quote?: string;
  cite?: string;
  source?: string;
  author?: string;
  kicker?: string;
  ref?: string;
  seal?: string;
  signature?: boolean;
  variant?: 'broadsheet' | 'dispatch';
}

const {
  quote,
  cite: citeProp,
  source: sourceProp,
  author,
  kicker,
  ref: dispatchRef = 'SPEC · REF 2026',
  seal: dispatchSeal = 'COLOPHON · 规范定稿',
  signature = false,
  variant = 'broadsheet'
} = Astro.props;

const cite = citeProp ?? sourceProp;
---

{variant === 'broadsheet' ? (
  <figure class="pull-quote variant-broadsheet">
    <div class="pull-masthead font-sans" aria-hidden="true">
      <span class="pull-kicker">§ {kicker || '重点引述 · PULL QUOTE'} §</span>
    </div>
    <div class="pull-rule-double" aria-hidden="true">
      <span class="rule-thick"></span>
      <span class="rule-thin"></span>
    </div>
    <blockquote class="pull-body font-serif">
      <span class="pull-quote-mark open font-serif" aria-hidden="true">“</span>
      <div class="pull-text font-serif">
        {quote ? quote : <slot />}
      </div>
      <span class="pull-quote-mark close font-serif" aria-hidden="true">”</span>
    </blockquote>
    <div class="pull-rule-double inverted" aria-hidden="true">
      <span class="rule-thin"></span>
      <span class="rule-thick"></span>
    </div>
    {(cite || author) && (
      <figcaption class="pull-caption font-sans">
        <span class="caption-dash">——</span>
        {author && (
          <strong class={`caption-author ${signature ? 'font-signature is-signature' : 'font-serif'}`}>
            {author}
          </strong>
        )}
        {author && cite && <span class="caption-sep">·</span>}
        {cite && <cite class="caption-source">{cite}</cite>}
      </figcaption>
    )}
  </figure>
) : (
  <figure class="pull-quote variant-dispatch">
    <div class="dispatch-frame">
      <div class="dispatch-header font-mono">
        <span class="dispatch-badge">
          <span class="badge-symbol">§</span>
          <span class="badge-text">{kicker || '专栏公报 · EDITORIAL DISPATCH'}</span>
        </span>
        <span class="dispatch-ref font-mono">{dispatchRef}</span>
      </div>
      <div class="dispatch-divider" aria-hidden="true"></div>
      <blockquote class="dispatch-body font-serif">
        <div class="dispatch-text font-serif">
          {quote ? quote : <slot />}
        </div>
      </blockquote>
      {(cite || author) && (
        <figcaption class="dispatch-footer font-sans">
          <div class="footer-seal font-mono">
            <span class="seal-icon">●</span> {dispatchSeal}
          </div>
          <div class="footer-cite font-sans">
            <span class="caption-dash">——</span>
            {author && <strong class="caption-author font-serif">{author}</strong>}
            {author && cite && <span class="caption-sep">·</span>}
            {cite && <cite class="caption-source">{cite}</cite>}
          </div>
        </figcaption>
      )}
    </div>
  </figure>
)}

<style>
  .pull-quote {
    margin: 40px 0;
    text-indent: 0 !important;
    position: relative;
    box-sizing: border-box;
  }

  /* -------------------------------------------------------------
     Variant 1: 古典报章大字提要金句 (Broadsheet Pull Quote)
     ------------------------------------------------------------- */
  .variant-broadsheet {
    padding: 10px 0;
    text-align: center;
    width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    .variant-broadsheet {
      margin-left: -16px;
      margin-right: -16px;
      width: calc(100% + 32px);
      max-width: calc(100% + 32px);
      padding: 12px 6px;
    }
  }

  .pull-masthead {
    display: flex;
    justify-content: center;
    margin-bottom: 8px;
    user-select: none;
  }

  .pull-kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 1.5px;
    color: var(--press-red);
    text-transform: uppercase;
    background: var(--press-red-soft);
    border: 1.5px solid var(--press-red);
    box-shadow: 1.5px 1.5px 0 var(--press-red);
    padding: 2px 10px;
    border-radius: 2px;
  }

  .pull-rule-double {
    display: flex;
    flex-direction: column;
    gap: 2.5px;
    margin-bottom: 16px;
    width: 100%;
    max-width: 100%;
  }

  .pull-rule-double.inverted {
    margin-top: 16px;
    margin-bottom: 12px;
    width: 100%;
    max-width: 100%;
  }

  .rule-thick {
    height: 3px;
    background: var(--line-solid);
    width: 100%;
  }

  .rule-thin {
    height: 1.5px;
    background: var(--line-solid);
    width: 100%;
  }

  .pull-body {
    all: unset;
    display: block;
    position: relative;
    padding: 8px 56px;
    font-size: clamp(19.5px, 2.7vw, 23px);
    font-weight: 700;
    line-height: 1.7;
    color: var(--ink-text);
    font-style: normal !important;
    letter-spacing: 0.2px;
    box-sizing: border-box;
  }

  .pull-body :global(p) {
    margin: 0 0 8px;
    text-indent: 0 !important;
    font-style: normal !important;
  }

  .pull-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .pull-quote-mark {
    position: absolute;
    font-size: 38px;
    line-height: 1;
    color: var(--press-red);
    opacity: 0.5;
    font-weight: 900;
    user-select: none;
    pointer-events: none;
  }

  .pull-quote-mark.open {
    left: 4px;
    top: -4px;
  }

  .pull-quote-mark.close {
    right: 4px;
    bottom: -16px;
  }

  @media (max-width: 767px) {
    .pull-body {
      padding: 6px 36px;
      font-size: 19px;
    }
    .pull-quote-mark {
      font-size: 30px;
    }
    .pull-quote-mark.open {
      left: 2px;
      top: -2px;
    }
    .pull-quote-mark.close {
      right: 2px;
      bottom: -12px;
    }
  }

  .pull-caption {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 12.5px;
    color: var(--ink-secondary);
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .caption-dash {
    color: var(--press-red);
    font-weight: 800;
  }

  .caption-author {
    color: var(--ink-text);
    font-weight: 800;
  }

  .caption-author.is-signature {
    font-family: var(--font-signature);
    font-size: 20px;
    font-weight: 400;
    letter-spacing: 0.5px;
    text-transform: none;
  }

  .caption-sep {
    color: var(--line-muted);
  }

  .caption-source {
    font-style: normal;
  }

  /* -------------------------------------------------------------
     Variant 2: 报刊专栏案卷引言卡 (Dispatch Frame Quote)
     ------------------------------------------------------------- */
  .variant-dispatch {
    margin: 34px 0;
    text-align: left;
  }

  .dispatch-frame {
    background: var(--paper-surface);
    border: 2.5px solid var(--line-solid);
    border-left: 6px solid var(--press-red);
    box-shadow: 4px 4px 0 var(--line-solid);
    border-radius: 2px;
    padding: 22px 28px 20px;
    position: relative;
    overflow: hidden;
    text-align: left;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .dispatch-frame:hover {
    transform: translate(-1.5px, -1.5px);
    box-shadow: 6px 6px 0 var(--line-solid);
  }

  .dispatch-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    user-select: none;
  }

  .dispatch-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.2px;
    color: var(--press-red);
    background: var(--press-red-soft);
    border: 1.5px solid var(--press-red);
    box-shadow: 1.5px 1.5px 0 var(--press-red);
    padding: 2.5px 9px;
    text-transform: uppercase;
    border-radius: 2px;
  }

  .dispatch-ref {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 800;
    color: var(--ink-secondary);
    letter-spacing: 1.2px;
    text-transform: uppercase;
  }

  .dispatch-divider {
    height: 2px;
    background: var(--line-solid);
    margin-bottom: 16px;
  }

  .dispatch-body {
    all: unset;
    display: block;
    font-size: 17px;
    line-height: 1.95;
    color: var(--ink-text);
    position: relative;
    z-index: 1;
    text-align: left;
    word-break: break-word;
  }

  .dispatch-text {
    text-align: left;
    font-size: inherit;
    line-height: inherit;
  }

  .dispatch-body :global(p) {
    margin-bottom: 8px;
    text-indent: 0 !important;
    font-style: normal !important;
    text-align: left;
    line-height: inherit;
    font-size: inherit;
  }

  .dispatch-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .dispatch-footer {
    margin-top: 16px;
    padding-top: 12px;
    border-top: 2px solid var(--line-solid);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 12px;
    color: var(--ink-secondary);
    flex-wrap: wrap;
    gap: 8px;
    user-select: none;
  }

  /* 公报专刊档案验讫红印戳 (Gazette Archival Seal Stamp) */
  .footer-seal {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--press-red);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    background: var(--press-red-soft, rgba(158, 42, 43, 0.08));
    border: 1.5px solid var(--press-red);
    padding: 2px 9px;
    border-radius: 0;
    box-shadow: 1.5px 1.5px 0 var(--press-red);
    transform: rotate(-0.6deg);
    transition: transform 0.2s ease, filter 0.2s ease;
  }

  .footer-seal:hover {
    transform: rotate(0deg) scale(1.05);
    filter: drop-shadow(0 2px 5px rgba(184, 39, 29, 0.25));
  }

  :global(:is(.dark, [data-theme="dark"])) .footer-seal {
    background: rgba(217, 83, 79, 0.12);
    border-color: var(--press-red);
    outline-color: var(--press-red);
    box-shadow: 1px 1px 0 rgba(0, 0, 0, 0.35);
  }

  .footer-cite {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
  }
</style>
