---
import { ChevronDown } from 'lucide-astro';

interface Props {
  summary: string;
  seal?: string;
  kicker?: string;
  code?: string;
  open?: boolean;
  dividerText?: string;
  footerText?: string;
  openText?: string;
  closeText?: string;
  className?: string;
}

const {
  summary,
  seal,
  kicker,
  code = 'ARCHIVE-REF',
  open = false,
  dividerText = '— 附录文献全文 · FULL APPENDIX —',
  footerText = 'DOCUMENT RECORD · 详细文档与规范归档',
  openText = '展开详情',
  closeText = '收起详情',
  className = ''
} = Astro.props;

const displaySeal = kicker ?? seal ?? '详情附录 · DETAILS';

// 清洗可能存在的“点击展开：”前缀
const cleanSummary = summary.replace(/^点击展开[：:]\s*/, '');
---

<details class={`editorial-declassified ${className}`} open={open}>
  <summary class="declassified-summary font-sans">
    <div class="summary-left">
      <!-- 典雅朱红公文印签 -->
      <span class="seal-badge">
        <span class="seal-symbol">§</span>
        <span class="seal-text">{displaySeal}</span>
      </span>
      {code && <span class="dossier-code font-mono">{code}</span>}
      <!-- 摘要标题 -->
      <span class="summary-title font-serif">{cleanSummary}</span>
    </div>

    <div class="summary-right font-mono">
      <span class="status-indicator">
        <span class="status-closed">{openText}</span>
        <span class="status-opened">{closeText}</span>
      </span>
      <div class="chevron-badge">
        <ChevronDown size={14} class="summary-chevron" />
      </div>
    </div>
  </summary>

  <!-- 包含所有解密正文与装饰的弹性容器（配合平滑展开折叠动画） -->
  <div class="dossier-expand-container">
    <!-- 展开分割线与装饰标 -->
    <div class="declassified-divider font-mono">
      <span class="divider-line"></span>
      <span class="divider-text">{dividerText}</span>
      <span class="divider-line"></span>
    </div>

    <!-- 解密卷宗正文区 -->
    <div class="declassified-body font-serif">
      <slot />
    </div>

    <!-- 卷宗归档底标 -->
    <div class="declassified-footer font-mono">
      <span class="footer-dot">●</span>
      <span>{footerText}</span>
      <span class="footer-dot">●</span>
    </div>
  </div>
</details>

<style>
  .editorial-declassified {
    margin: 32px 0;
    border: 2.5px solid var(--line-solid);
    border-left: 6px solid var(--press-red);
    background-color: var(--paper-surface);
    box-shadow: 4px 4px 0 var(--line-solid);
    border-radius: 2px;
    text-indent: 0;
    position: relative;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .editorial-declassified:hover {
    transform: translate(-1.5px, -1.5px);
    box-shadow: 5.5px 5.5px 0 var(--line-solid);
  }

  /* 摘要头部栏 */
  .declassified-summary {
    padding: 14px 18px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    user-select: none;
    background: transparent;
    list-style: none;
    transition: background 0.15s ease;
  }

  :global(:is(.dark, [data-theme="dark"])) .declassified-summary {
    background: transparent;
  }

  .declassified-summary:hover {
    background: rgba(44, 40, 37, 0.02);
  }

  :global(:is(.dark, [data-theme="dark"])) .declassified-summary:hover {
    background: rgba(255, 255, 255, 0.02);
  }

  .declassified-summary::-webkit-details-marker {
    display: none;
  }

  .summary-left {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
    min-width: 0;
    flex-wrap: wrap;
  }

  /* 档案解密标识签 */
  .seal-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 800;
    color: var(--press-red);
    background: var(--press-red-soft, rgba(158, 42, 43, 0.06));
    border: 1.5px solid var(--press-red);
    box-shadow: 1.5px 1.5px 0 var(--press-red);
    padding: 2px 8px;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    white-space: nowrap;
    flex-shrink: 0;
    border-radius: 2px;
    transition: background-color 0.15s ease;
  }

  .seal-badge .seal-text {
    writing-mode: horizontal-tb;
    text-orientation: mixed;
  }

  .editorial-declassified:hover .seal-badge {
    transform: none;
    filter: none;
  }

  .seal-symbol {
    font-size: 11px;
    line-height: 1;
    opacity: 0.9;
  }

  :global(:is(.dark, [data-theme="dark"])) .seal-badge {
    background: rgba(217, 83, 79, 0.1);
    border-color: var(--press-red);
    box-shadow: 1.5px 1.5px 0 var(--press-red);
  }

  .dossier-code {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 800;
    color: var(--ink-light);
    letter-spacing: 0.5px;
    padding: 1.5px 6px;
    background: rgba(44, 40, 37, 0.04);
    border: 1.5px solid var(--line-solid);
    border-radius: 2px;
    white-space: nowrap;
  }

  .summary-title {
    font-size: 15.5px;
    font-weight: 800;
    line-height: 1.4;
    color: var(--ink-text);
    transition: color 0.15s ease;
  }

  .declassified-summary:hover .summary-title {
    color: var(--ink-text);
  }

  .summary-right {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  /* 状态文本滑入滑出切换 */
  .status-indicator {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 800;
    color: var(--ink-secondary);
    letter-spacing: 0.5px;
    position: relative;
    height: 16px;
    line-height: 16px;
    overflow: hidden;
    min-width: 52px;
    text-align: right;
  }

  .status-closed,
  .status-opened {
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
    display: block;
  }

  .editorial-declassified:not([open]) .status-opened {
    opacity: 0;
    transform: translateY(100%);
    position: absolute;
    top: 0;
    right: 0;
    pointer-events: none;
  }

  .editorial-declassified:not([open]) .status-closed {
    opacity: 1;
    transform: translateY(0);
  }

  .editorial-declassified[open] .status-closed {
    opacity: 0;
    transform: translateY(-100%);
    position: absolute;
    top: 0;
    right: 0;
    pointer-events: none;
  }

  .editorial-declassified[open] .status-opened {
    opacity: 1;
    transform: translateY(0);
    color: var(--press-red);
  }

  /* 方块指示微标 */
  .chevron-badge {
    width: 24px;
    height: 24px;
    border-radius: 2px;
    border: 1.5px solid var(--line-solid);
    background: var(--paper-bg);
    box-shadow: 1.5px 1.5px 0 var(--line-solid);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-secondary);
    transition: all 0.2s ease;
  }

  .editorial-declassified:hover .chevron-badge {
    border-color: var(--line-solid);
    color: var(--ink-text);
  }

  .editorial-declassified[open] .chevron-badge {
    transform: rotate(180deg);
    border-color: var(--press-red);
    background: var(--press-red);
    color: #ffffff;
    box-shadow: 1.5px 1.5px 0 var(--press-red);
  }

  .summary-chevron {
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .editorial-declassified[open] .summary-chevron {
    transform: rotate(180deg);
  }

  /* 展开内容包裹器 */
  .dossier-expand-container {
    overflow: hidden;
  }

  /* 展开分隔线 */
  .declassified-divider {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 18px 0;
    font-size: 10px;
    color: var(--ink-light);
    letter-spacing: 1px;
    user-select: none;
  }

  .divider-line {
    flex: 1;
    height: 2px;
    background: var(--line-solid);
  }

  .divider-text {
    color: var(--ink-light);
    opacity: 0.85;
  }

  /* 正文卷宗面板 */
  .declassified-body {
    padding: 16px 20px;
    font-size: 15px;
    line-height: 1.8;
    color: var(--ink-text);
  }

  .declassified-body :global(p) {
    margin-bottom: 10px !important;
    text-indent: 0 !important;
  }

  .declassified-body :global(p:last-child) {
    margin-bottom: 0 !important;
  }

  /* 卷宗封底 */
  .declassified-footer {
    padding: 0 20px 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 10px;
    color: var(--ink-light);
    letter-spacing: 0.6px;
    user-select: none;
  }

  .footer-dot {
    font-size: 6px;
    color: var(--press-red);
  }

  @media (max-width: 640px) {
    .declassified-summary {
      padding: 12px 14px;
      gap: 10px;
    }
    .summary-title {
      font-size: 14.5px;
    }
    .status-indicator {
      display: none;
    }
    .declassified-body {
      padding: 14px 16px;
    }
  }
</style>

<script>
  class DeclassifiedAccordion {
    el: HTMLDetailsElement;
    summary: HTMLElement;
    content: HTMLElement;
    animation: Animation | null;
    contentAnimation: Animation | null;
    isClosing: boolean;
    isExpanding: boolean;

    constructor(el: HTMLDetailsElement) {
      this.el = el;
      this.summary = el.querySelector('summary') as HTMLElement;
      this.content = el.querySelector('.dossier-expand-container') as HTMLElement;
      this.animation = null;
      this.contentAnimation = null;
      this.isClosing = false;
      this.isExpanding = false;

      if (!this.summary || !this.content) return;
      this.summary.addEventListener('click', (e) => this.onClick(e));
    }

    onClick(e: MouseEvent) {
      e.preventDefault();
      this.el.style.overflow = 'hidden';

      if (this.isClosing || !this.el.open) {
        this.open();
      } else if (this.isExpanding || this.el.open) {
        this.shrink();
      }
    }

    shrink() {
      this.isClosing = true;
      const borderExtra = this.el.offsetHeight - this.el.clientHeight;
      const startHeight = `${this.el.offsetHeight}px`;
      const endHeight = `${this.summary.offsetHeight + borderExtra}px`;

      if (this.animation) this.animation.cancel();
      if (this.contentAnimation) this.contentAnimation.cancel();

      this.animation = this.el.animate(
        {
          height: [startHeight, endHeight]
        },
        {
          duration: 260,
          easing: 'cubic-bezier(0.16, 1, 0.3, 1)'
        }
      );

      this.contentAnimation = this.content.animate(
        {
          opacity: [1, 0],
          transform: ['translateY(0)', 'translateY(-8px)']
        },
        {
          duration: 200,
          easing: 'ease-in'
        }
      );

      this.animation.onfinish = () => this.onAnimationFinish(false);
      this.animation.oncancel = () => {
        this.isClosing = false;
      };
    }

    open() {
      const borderExtra = this.el.offsetHeight - this.el.clientHeight;
      this.el.style.height = `${this.el.offsetHeight}px`;
      this.el.open = true;

      window.requestAnimationFrame(() => this.expand(borderExtra));
    }

    expand(borderExtra: number) {
      this.isExpanding = true;
      const startHeight = `${this.el.offsetHeight}px`;
      const endHeight = `${this.summary.offsetHeight + this.content.offsetHeight + borderExtra}px`;

      if (this.animation) this.animation.cancel();
      if (this.contentAnimation) this.contentAnimation.cancel();

      this.animation = this.el.animate(
        {
          height: [startHeight, endHeight]
        },
        {
          duration: 320,
          easing: 'cubic-bezier(0.16, 1, 0.3, 1)'
        }
      );

      this.contentAnimation = this.content.animate(
        {
          opacity: [0, 1],
          transform: ['translateY(-10px)', 'translateY(0)']
        },
        {
          duration: 280,
          easing: 'cubic-bezier(0.16, 1, 0.3, 1)'
        }
      );

      this.animation.onfinish = () => this.onAnimationFinish(true);
      this.animation.oncancel = () => {
        this.isExpanding = false;
      };
    }

    onAnimationFinish(open: boolean) {
      this.el.open = open;
      this.animation = null;
      this.contentAnimation = null;
      this.isClosing = false;
      this.isExpanding = false;
      this.el.style.height = '';
      this.el.style.overflow = '';
    }
  }

  function initAccordions() {
    document.querySelectorAll<HTMLDetailsElement>('details.editorial-declassified').forEach((el) => {
      if (el.getAttribute('data-accordion-ready') === 'true') return;
      el.setAttribute('data-accordion-ready', 'true');
      new DeclassifiedAccordion(el);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAccordions);
  } else {
    initAccordions();
  }
  document.addEventListener('astro:page-load', initAccordions);
</script>
