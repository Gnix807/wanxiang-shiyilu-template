---
/**
 * 苹果同款极致质感图片灯箱 (Apple-style Image Lightbox)
 * 
 * 核心特色：
 * 1. 苹果标志性毛玻璃纯净幕布 (backdrop-blur-2xl + 视网膜磨砂)
 * 2. FLIP 真实元素无缝缩放物理动效 (从点击的原图矩形平滑弹射展开，关闭时平滑缩回收纳回原位)
 * 3. 苹果顶级看图交互：
 *    - 点击或双击图片：平滑无级放大（支持 2.5x / 100% 原始分辨率 / 最大 4.5x）
 *    - 放大状态支持鼠标/触控拖拽平移 (grab / grabbing)，视口边界智能吸附
 *    - 鼠标滚轮平滑缩放，聚焦于鼠标所在原点
 *    - 顶部磨砂悬浮胶囊：缩放切换 (+/-)、1:1 原画质像素查看、多图计数与关闭按纽 (✕)
 * 4. 键盘 (Esc/方向键/加减号)、手势下滑关闭、多图画廊顺畅切换
 * 5. 全站自适应：完美支持 .prose 正文图片、<Plate> 出版物插图、Markdown 原生图片
 */
---

<div id="apple-lightbox-root" class="fixed inset-0 z-[99990] hidden select-none" aria-modal="true" role="dialog" transition:persist="apple-lightbox">
  {/* 苹果质感高斯模糊磨砂背景 */}
  <div 
    id="apple-lightbox-backdrop" 
    class="fixed inset-0 bg-[#f6eddc]/85 dark:bg-[#121212]/85 backdrop-blur-2xl transition-opacity duration-300 opacity-0 cursor-zoom-out"
    title="点击背景关闭 (Esc)"
  ></div>

  {/* 顶部中央状态胶囊 (计数与缩放比例) */}
  <div 
    id="apple-lightbox-counter" 
    class="fixed top-5 left-1/2 -translate-x-1/2 z-[99998] px-3.5 py-1 rounded-full text-[11px] font-mono font-bold tracking-widest text-[#1a1a1a]/80 dark:text-[#e8e6e3]/80 bg-white/70 dark:bg-neutral-800/70 backdrop-blur-xl border border-[#1a1a1a]/10 dark:border-white/10 shadow-[0_4px_16px_rgba(0,0,0,0.06)] pointer-events-none transition-all duration-200 opacity-0 -translate-y-2 flex items-center gap-1.5"
  >
    <span id="apple-lightbox-counter-text">1 / 1</span>
    <span id="apple-lightbox-zoom-badge" class="hidden text-[9px] px-1 py-0.2 rounded-xs bg-[#1a1a1a]/10 dark:bg-white/10 font-bold">100%</span>
  </div>

  {/* 顶部右侧苹果极简悬浮工具栏 (缩放切换、1:1 查看、关闭按键) */}
  <div 
    id="apple-lightbox-toolbar" 
    class="fixed top-5 right-5 z-[99998] flex items-center gap-2 transition-all duration-200 opacity-0 translate-y-2"
  >
    {/* 缩放切换按钮 (+/-) */}
    <button 
      id="apple-lightbox-zoom-toggle" 
      type="button"
      class="w-10 h-10 rounded-full flex items-center justify-center text-[#1a1a1a] dark:text-[#e8e6e3] bg-white/70 dark:bg-neutral-800/70 hover:bg-white dark:hover:bg-neutral-700 active:scale-95 backdrop-blur-xl border border-[#1a1a1a]/10 dark:border-white/15 shadow-[0_4px_16px_rgba(0,0,0,0.08)] cursor-pointer transition-all duration-200"
      aria-label="放大或还原图片"
      title="缩放切换 (点击图片或滚轮)"
    >
      {/* 放大图标 */}
      <svg id="apple-zoom-in-icon" class="w-4 h-4 stroke-[2.2]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <circle cx="11" cy="11" r="7" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" />
        <line x1="11" y1="8" x2="11" y2="14" />
        <line x1="8" y1="11" x2="14" y2="11" />
      </svg>
      {/* 缩小还原图标 */}
      <svg id="apple-zoom-out-icon" class="w-4 h-4 stroke-[2.2] hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <circle cx="11" cy="11" r="7" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" />
        <line x1="8" y1="11" x2="14" y2="11" />
      </svg>
    </button>

    {/* 1:1 原始分辨率按钮 */}
    <button 
      id="apple-lightbox-zoom-100" 
      type="button"
      class="h-10 px-3 rounded-full flex items-center justify-center text-[11px] font-mono font-black text-[#1a1a1a] dark:text-[#e8e6e3] bg-white/70 dark:bg-neutral-800/70 hover:bg-white dark:hover:bg-neutral-700 active:scale-95 backdrop-blur-xl border border-[#1a1a1a]/10 dark:border-white/15 shadow-[0_4px_16px_rgba(0,0,0,0.08)] cursor-pointer transition-all duration-200"
      aria-label="原始像素尺寸"
      title="以 100% 原始清晰度查看"
    >
      1:1
    </button>

    {/* 关闭按键 (✕) */}
    <button 
      id="apple-lightbox-close" 
      type="button"
      class="w-10 h-10 rounded-full flex items-center justify-center text-[#1a1a1a] dark:text-[#e8e6e3] bg-white/70 dark:bg-neutral-800/70 hover:bg-white dark:hover:bg-neutral-700 active:scale-95 backdrop-blur-xl border border-[#1a1a1a]/10 dark:border-white/15 shadow-[0_4px_16px_rgba(0,0,0,0.08)] cursor-pointer transition-all duration-200 hover:rotate-90"
      aria-label="关闭画廊 (Esc)"
      title="关闭 (Esc)"
    >
      <svg class="w-4 h-4 stroke-[2.2]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  {/* 左翻页箭头 */}
  <button 
    id="apple-lightbox-prev" 
    type="button"
    class="fixed left-4 sm:left-6 top-1/2 -translate-y-1/2 z-[99998] w-11 h-11 rounded-full flex items-center justify-center text-[#1a1a1a] dark:text-[#e8e6e3] bg-white/70 dark:bg-neutral-800/70 hover:bg-white dark:hover:bg-neutral-700 active:scale-90 backdrop-blur-xl border border-[#1a1a1a]/10 dark:border-white/15 shadow-[0_4px_16px_rgba(0,0,0,0.08)] cursor-pointer transition-all duration-200 opacity-0 -translate-x-3"
    aria-label="上一张图片"
    title="上一张 (←)"
  >
    <svg class="w-5 h-5 stroke-[2.2]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
    </svg>
  </button>

  {/* 右翻页箭头 */}
  <button 
    id="apple-lightbox-next" 
    type="button"
    class="fixed right-4 sm:right-6 top-1/2 -translate-y-1/2 z-[99998] w-11 h-11 rounded-full flex items-center justify-center text-[#1a1a1a] dark:text-[#e8e6e3] bg-white/70 dark:bg-neutral-800/70 hover:bg-white dark:hover:bg-neutral-700 active:scale-90 backdrop-blur-xl border border-[#1a1a1a]/10 dark:border-white/15 shadow-[0_4px_16px_rgba(0,0,0,0.08)] cursor-pointer transition-all duration-200 opacity-0 translate-x-3"
    aria-label="下一张图片"
    title="下一张 (→)"
  >
    <svg class="w-5 h-5 stroke-[2.2]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
    </svg>
  </button>

  {/* 核心舞台区域 */}
  <div id="apple-lightbox-stage" class="fixed inset-0 z-[99995] flex items-center justify-center pointer-events-none p-3 sm:p-8">
    <div id="apple-lightbox-container" class="relative flex flex-col items-center justify-center pointer-events-auto max-w-[94vw] max-h-[88vh]">
      {/* 动画展示的活动大图 */}
      <img 
        id="apple-lightbox-img" 
        src="" 
        alt="" 
        draggable="false"
        class="max-w-full max-h-[82vh] object-contain rounded-xl sm:rounded-2xl shadow-[0_24px_64px_-12px_rgba(0,0,0,0.28)] dark:shadow-[0_28px_72px_-12px_rgba(0,0,0,0.8)] border border-[#1a1a1a]/10 dark:border-white/15 cursor-zoom-in will-change-transform bg-white/40 dark:bg-neutral-900/40 select-none"
      />

      {/* 底部悬浮毛玻璃图注胶囊 */}
      <div 
        id="apple-lightbox-caption" 
        class="mt-3 px-4 py-1.5 rounded-full text-xs font-sans font-medium text-[#1a1a1a] dark:text-[#e8e6e3] bg-white/75 dark:bg-neutral-800/75 backdrop-blur-xl border border-[#1a1a1a]/10 dark:border-white/10 shadow-[0_4px_16px_rgba(0,0,0,0.06)] tracking-wide max-w-[85vw] truncate text-center transition-all duration-200 opacity-0 translate-y-2 pointer-events-auto"
      >
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* 正文与图版内的所有图片悬停展示放大手势 */
  article .prose img,
  .editorial-plate img,
  figure:not(.no-zoom) img,
  .prose figure img,
  img[data-zoomable] {
    cursor: zoom-in !important;
    transition: filter 0.15s ease, opacity 0.2s ease;
  }

  article .prose img:hover,
  .editorial-plate img:hover,
  img[data-zoomable]:hover {
    filter: brightness(1.02);
  }

  /* 灯箱处于放大平移态时的专用类名 */
  body.apple-lightbox-zoomed #apple-lightbox-img {
    cursor: grab !important;
    max-width: none !important;
    max-height: none !important;
  }

  body.apple-lightbox-dragging #apple-lightbox-img {
    cursor: grabbing !important;
  }
</style>

<script is:inline>
(() => {
  // 全局 Apple 风格灯箱交互管理器
  function initAppleLightbox() {
    const root = document.getElementById('apple-lightbox-root');
    const backdrop = document.getElementById('apple-lightbox-backdrop');
    const stage = document.getElementById('apple-lightbox-stage');
    const container = document.getElementById('apple-lightbox-container');
    const cloneImg = document.getElementById('apple-lightbox-img');
    const captionEl = document.getElementById('apple-lightbox-caption');
    const counterEl = document.getElementById('apple-lightbox-counter');
    const counterText = document.getElementById('apple-lightbox-counter-text');
    const zoomBadge = document.getElementById('apple-lightbox-zoom-badge');
    const toolbar = document.getElementById('apple-lightbox-toolbar');
    const zoomToggleBtn = document.getElementById('apple-lightbox-zoom-toggle');
    const zoomInIcon = document.getElementById('apple-zoom-in-icon');
    const zoomOutIcon = document.getElementById('apple-zoom-out-icon');
    const zoom100Btn = document.getElementById('apple-lightbox-zoom-100');
    const closeBtn = document.getElementById('apple-lightbox-close');
    const prevBtn = document.getElementById('apple-lightbox-prev');
    const nextBtn = document.getElementById('apple-lightbox-next');

    if (!root || !backdrop || !cloneImg || !stage) return;

    if (window.__appleLightboxBound) return;
    window.__appleLightboxBound = true;

    let gallery = [];
    let currentIndex = -1;
    let activeSourceImg = null;
    let isOpen = false;
    let isAnimating = false;
    let targetRect = { x: 0, y: 0, w: 0, h: 0 };

    // 缩放与平移状态机
    let zoomLevel = 1.0;
    let panX = 0;
    let panY = 0;
    let isDragging = false;
    let dragStartX = 0;
    let dragStartY = 0;
    let startPanX = 0;
    let startPanY = 0;
    let hasDragged = false;
    let touchStartY = 0;

    // 收集当前页面全部可放大的正文图片 (利用 Set 严格去重)
    function collectZoomableImages() {
      const candidates = Array.from(new Set(document.querySelectorAll(
        'article .prose img, .editorial-plate img, figure:not(.no-zoom) img, .prose figure img, img[data-zoomable]'
      )));

      // 过滤掉头像、徽标及尺寸微小的图标
      return candidates.filter((img) => {
        if (img.classList.contains('avatar') || img.classList.contains('no-zoom')) return false;
        if (img.closest('.author-card') || img.closest('nav') || img.closest('footer')) return false;
        const rect = img.getBoundingClientRect();
        return rect.width > 30 && rect.height > 30;
      });
    }

    // 提取优雅的图片图注
    function getImageCaption(img) {
      // 1. 如果在 <Plate> 组件内
      const plate = img.closest('.editorial-plate');
      if (plate) {
        const fig = plate.querySelector('.plate-tag')?.textContent?.trim();
        const text = plate.querySelector('.plate-text')?.textContent?.trim();
        if (fig && text) return `${fig} ${text}`;
        if (text) return text;
      }
      // 2. 如果在常规 <figure> 内
      const figcaption = img.closest('figure')?.querySelector('figcaption');
      if (figcaption && figcaption.textContent?.trim()) {
        return figcaption.textContent.trim();
      }
      // 3. 原生 alt 或 title
      return img.alt?.trim() || img.title?.trim() || '';
    }

    // 计算 Apple 动效所需的目标居中尺寸与位置
    function computeTargetLayout(img) {
      let aspect = 16 / 9;
      if (img.naturalWidth && img.naturalHeight) {
        aspect = img.naturalWidth / img.naturalHeight;
      } else {
        const rect = img.getBoundingClientRect();
        if (rect.width > 20 && rect.height > 20) {
          aspect = rect.width / rect.height;
        }
      }

      const padX = window.innerWidth < 640 ? 24 : 64;
      const padY = window.innerWidth < 640 ? 80 : 100;
      const maxW = Math.min(window.innerWidth - padX, (img.naturalWidth && img.naturalWidth > 100) ? img.naturalWidth : window.innerWidth - padX);
      const maxH = Math.min(window.innerHeight - padY, (img.naturalHeight && img.naturalHeight > 100) ? img.naturalHeight : window.innerHeight - padY);

      let targetW, targetH;
      if (maxW / maxH > aspect) {
        targetH = maxH;
        targetW = targetH * aspect;
      } else {
        targetW = maxW;
        targetH = targetW / aspect;
      }

      const targetX = (window.innerWidth - targetW) / 2;
      const targetY = (window.innerHeight - targetH) / 2;

      return { x: targetX, y: targetY, w: targetW, h: targetH };
    }

    // 限制拖拽位移范围，防止图片完全移出可视区
    function clampPan() {
      if (zoomLevel <= 1.0) {
        panX = 0;
        panY = 0;
        return;
      }
      const scaledW = targetRect.w * zoomLevel;
      const scaledH = targetRect.h * zoomLevel;

      const maxX = Math.max(0, (scaledW - window.innerWidth) / 2 + 60);
      const maxY = Math.max(0, (scaledH - window.innerHeight) / 2 + 60);

      panX = Math.max(-maxX, Math.min(maxX, panX));
      panY = Math.max(-maxY, Math.min(maxY, panY));
    }

    // 更新变换应用与控件状态
    function applyTransform(animated = true) {
      if (!cloneImg) return;
      if (animated) {
        cloneImg.style.transition = 'transform 260ms cubic-bezier(0.16, 1, 0.3, 1)';
      } else {
        cloneImg.style.transition = 'none';
      }
      cloneImg.style.transform = `translate3d(${panX}px, ${panY}px, 0) scale(${zoomLevel})`;

      // 更新缩放指示与图标
      const isZoomed = zoomLevel > 1.05;
      if (isZoomed) {
        document.body.classList.add('apple-lightbox-zoomed');
        zoomInIcon?.classList.add('hidden');
        zoomOutIcon?.classList.remove('hidden');
        if (zoomBadge) {
          zoomBadge.textContent = `${Math.round(zoomLevel * 100)}%`;
          zoomBadge.classList.remove('hidden');
        }
        // 放大时弱化翻页与图注，呈现纯净无遮挡的巨幕画卷
        if (captionEl) captionEl.style.opacity = '0';
        if (prevBtn) prevBtn.style.opacity = '0';
        if (nextBtn) nextBtn.style.opacity = '0';
      } else {
        document.body.classList.remove('apple-lightbox-zoomed');
        zoomInIcon?.classList.remove('hidden');
        zoomOutIcon?.classList.add('hidden');
        if (zoomBadge) zoomBadge.classList.add('hidden');
        if (captionEl && captionEl.textContent) captionEl.style.opacity = '1';
        if (gallery.length > 1) {
          if (prevBtn) prevBtn.style.opacity = '1';
          if (nextBtn) nextBtn.style.opacity = '1';
        }
      }
    }

    // 重置缩放态至 1.0 满屏自适应
    function resetZoom(animated = true) {
      zoomLevel = 1.0;
      panX = 0;
      panY = 0;
      applyTransform(animated);
    }

    // 设置指定倍率缩放并聚焦于指定视口坐标 (如点击点)
    function setZoom(newZoom, originX, originY, animated = true) {
      const prevZoom = zoomLevel;
      zoomLevel = Math.max(1.0, Math.min(4.5, newZoom));

      if (zoomLevel <= 1.02) {
        resetZoom(animated);
        return;
      }

      if (originX !== undefined && originY !== undefined && prevZoom <= 1.02) {
        // 计算点击原点相对于图片中心点的偏移，反向推移实现以原点为轴心放大
        const centerX = window.innerWidth / 2;
        const centerY = window.innerHeight / 2;
        const offsetX = originX - centerX;
        const offsetY = originY - centerY;
        panX = -offsetX * (zoomLevel - 1.0);
        panY = -offsetY * (zoomLevel - 1.0);
      }

      clampPan();
      applyTransform(animated);
    }

    // 缩放切换：1x ↔ 最佳放大清晰度
    function toggleZoom(originX, originY) {
      if (zoomLevel > 1.05) {
        resetZoom(true);
      } else {
        // 计算自然分辨率或至少 2.2 倍放大
        let targetScale = 2.2;
        if (activeSourceImg && activeSourceImg.naturalWidth && targetRect.w > 0) {
          const naturalScale = activeSourceImg.naturalWidth / targetRect.w;
          targetScale = Math.min(4.0, Math.max(2.0, naturalScale));
        }
        setZoom(targetScale, originX, originY, true);
      }
    }

    // 打开灯箱 (FLIP 物理平滑弹出)
    function openLightbox(index) {
      if (isAnimating || index < 0 || index >= gallery.length) return;
      isAnimating = true;
      isOpen = true;
      currentIndex = index;
      activeSourceImg = gallery[currentIndex];

      resetZoom(false);

      const startRect = activeSourceImg.getBoundingClientRect();
      targetRect = computeTargetLayout(activeSourceImg);

      // 设置克隆大图源与初始位姿
      cloneImg.src = activeSourceImg.currentSrc || activeSourceImg.src;
      cloneImg.style.width = `${targetRect.w}px`;
      cloneImg.style.height = `${targetRect.h}px`;
      cloneImg.style.opacity = '1';

      cloneImg.onload = () => {
        if (!isOpen) return;
        if (cloneImg.naturalWidth && cloneImg.naturalHeight) {
          const aspect = cloneImg.naturalWidth / cloneImg.naturalHeight;
          const padX = window.innerWidth < 640 ? 24 : 64;
          const padY = window.innerWidth < 640 ? 80 : 100;
          const maxW = Math.min(window.innerWidth - padX, cloneImg.naturalWidth || (window.innerWidth - padX));
          const maxH = Math.min(window.innerHeight - padY, cloneImg.naturalHeight || (window.innerHeight - padY));
          let targetW, targetH;
          if (maxW / maxH > aspect) {
            targetH = maxH;
            targetW = targetH * aspect;
          } else {
            targetW = maxW;
            targetH = targetW / aspect;
          }
          targetRect = {
            x: (window.innerWidth - targetW) / 2,
            y: (window.innerHeight - targetH) / 2,
            w: targetW,
            h: targetH
          };
          cloneImg.style.width = `${targetRect.w}px`;
          cloneImg.style.height = `${targetRect.h}px`;
          if (zoomLevel <= 1.05) {
            applyTransform(true);
          }
        }
      };

      // 计算初态 FLIP 逆变换（准确还原到原图大小和位置）
      const scaleX = startRect.width / targetRect.w;
      const scaleY = startRect.height / targetRect.h;
      const transX = startRect.left + startRect.width / 2 - (targetRect.x + targetRect.w / 2);
      const transY = startRect.top + startRect.height / 2 - (targetRect.y + targetRect.h / 2);

      cloneImg.style.transition = 'none';
      cloneImg.style.transform = `translate3d(${transX}px, ${transY}px, 0) scale(${scaleX}, ${scaleY})`;

      // 提取图注
      const captionText = getImageCaption(activeSourceImg);
      if (captionText) {
        captionEl.textContent = captionText;
        captionEl.classList.remove('hidden');
      } else {
        captionEl.textContent = '';
        captionEl.classList.add('hidden');
      }

      // 多图计数与导航按钮
      if (gallery.length > 1) {
        if (counterText) counterText.textContent = `${currentIndex + 1} / ${gallery.length}`;
        counterEl.classList.remove('hidden');
        prevBtn.classList.remove('hidden');
        nextBtn.classList.remove('hidden');
      } else {
        counterEl.classList.add('hidden');
        prevBtn.classList.add('hidden');
        nextBtn.classList.add('hidden');
      }

      // 展开 DOM 容器
      root.classList.remove('hidden');
      root.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';

      // 隐藏页面原图（营造升空飞出的物理错觉）
      activeSourceImg.style.opacity = '0';

      // 强制重绘，触发 Apple Spring 动画曲线
      cloneImg.offsetHeight;

      requestAnimationFrame(() => {
        // 苹果标志性减速缓动曲线 (cubic-bezier(0.16, 1, 0.3, 1))
        cloneImg.style.transition = 'transform 360ms cubic-bezier(0.16, 1, 0.3, 1)';
        cloneImg.style.transform = 'translate3d(0px, 0px, 0) scale(1)';

        // 浮层元素渐入
        backdrop.style.opacity = '1';
        toolbar.style.opacity = '1';
        toolbar.style.transform = 'translateY(0)';
        captionEl.style.opacity = '1';
        captionEl.style.transform = 'translateY(0)';

        if (gallery.length > 1) {
          counterEl.style.opacity = '1';
          counterEl.style.transform = 'translateX(-50%) translateY(0)';
          prevBtn.style.opacity = '1';
          prevBtn.style.transform = 'translateY(-50%) translateX(0)';
          nextBtn.style.opacity = '1';
          nextBtn.style.transform = 'translateY(-50%) translateX(0)';
        }

        setTimeout(() => {
          isAnimating = false;
        }, 360);
      });
    }

    // 关闭灯箱 (平滑逆向收纳回原位)
    function closeLightbox() {
      if (isAnimating || !isOpen) return;
      isAnimating = true;

      resetZoom(false);

      // 重新测量当前页面原图位置（防止用户在其他操作中发生偏移）
      let endRect = null;
      if (activeSourceImg && activeSourceImg.isConnected) {
        endRect = activeSourceImg.getBoundingClientRect();
      }

      // 浮层控件渐隐
      backdrop.style.opacity = '0';
      toolbar.style.opacity = '0';
      toolbar.style.transform = 'translateY(8px)';
      captionEl.style.opacity = '0';
      captionEl.style.transform = 'translateY(8px)';
      counterEl.style.opacity = '0';
      counterEl.style.transform = 'translateX(-50%) translateY(-8px)';
      prevBtn.style.opacity = '0';
      prevBtn.style.transform = 'translateY(-50%) translateX(-12px)';
      nextBtn.style.opacity = '0';
      nextBtn.style.transform = 'translateY(-50%) translateX(12px)';

      if (endRect && targetRect.w > 0) {
        const scaleX = endRect.width / targetRect.w;
        const scaleY = endRect.height / targetRect.h;
        const transX = endRect.left + endRect.width / 2 - (targetRect.x + targetRect.w / 2);
        const transY = endRect.top + endRect.height / 2 - (targetRect.y + targetRect.h / 2);

        cloneImg.style.transition = 'transform 300ms cubic-bezier(0.25, 1, 0.5, 1), opacity 260ms ease';
        cloneImg.style.transform = `translate3d(${transX}px, ${transY}px, 0) scale(${scaleX}, ${scaleY})`;
        cloneImg.style.opacity = '0';
      } else {
        cloneImg.style.transition = 'transform 260ms ease, opacity 260ms ease';
        cloneImg.style.transform = 'scale(0.92)';
        cloneImg.style.opacity = '0';
      }

      setTimeout(() => {
        if (activeSourceImg) {
          activeSourceImg.style.opacity = '1';
        }
        root.classList.add('hidden');
        root.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        document.body.classList.remove('apple-lightbox-zoomed', 'apple-lightbox-dragging');
        cloneImg.src = '';
        isOpen = false;
        isAnimating = false;
      }, 300);
    }

    // 切换图片 (上一张 / 下一张)
    function switchImage(direction) {
      if (!isOpen || isAnimating || gallery.length <= 1) return;
      isAnimating = true;

      resetZoom(false);

      const newIndex = (currentIndex + direction + gallery.length) % gallery.length;
      const oldSourceImg = activeSourceImg;
      const nextSourceImg = gallery[newIndex];

      // 平滑淡出位移
      cloneImg.style.transition = 'transform 160ms ease-out, opacity 160ms ease-out';
      cloneImg.style.opacity = '0';
      cloneImg.style.transform = direction > 0 ? 'translateX(-30px) scale(0.96)' : 'translateX(30px) scale(0.96)';

      setTimeout(() => {
        // 恢复旧图透明度
        if (oldSourceImg) oldSourceImg.style.opacity = '1';

        // 更新状态
        currentIndex = newIndex;
        activeSourceImg = nextSourceImg;
        activeSourceImg.style.opacity = '0';

        targetRect = computeTargetLayout(activeSourceImg);
        cloneImg.src = activeSourceImg.currentSrc || activeSourceImg.src;
        cloneImg.style.width = `${targetRect.w}px`;
        cloneImg.style.height = `${targetRect.h}px`;

        // 更新文字与计数
        const cap = getImageCaption(activeSourceImg);
        if (cap) {
          captionEl.textContent = cap;
          captionEl.classList.remove('hidden');
        } else {
          captionEl.classList.add('hidden');
        }
        if (counterText) counterText.textContent = `${currentIndex + 1} / ${gallery.length}`;

        // 从相反方向滑入
        cloneImg.style.transition = 'none';
        cloneImg.style.transform = direction > 0 ? 'translateX(30px) scale(0.96)' : 'translateX(-30px) scale(0.96)';
        cloneImg.offsetHeight;

        requestAnimationFrame(() => {
          cloneImg.style.transition = 'transform 280ms cubic-bezier(0.16, 1, 0.3, 1), opacity 240ms ease';
          cloneImg.style.opacity = '1';
          cloneImg.style.transform = 'translate3d(0, 0, 0) scale(1)';
          setTimeout(() => {
            isAnimating = false;
          }, 280);
        });
      }, 160);
    }

    // ==================== 事件监听体系 ====================

    // 点击背景或关闭按钮关闭灯箱
    backdrop.addEventListener('click', closeLightbox);
    closeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      closeLightbox();
    });

    // 缩放切换按钮
    zoomToggleBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleZoom(window.innerWidth / 2, window.innerHeight / 2);
    });

    // 1:1 原始清晰度按钮
    zoom100Btn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!activeSourceImg || targetRect.w <= 0) return;
      const naturalW = activeSourceImg.naturalWidth || targetRect.w;
      const ratio = naturalW / targetRect.w;
      setZoom(Math.max(1.0, Math.min(4.5, ratio)), window.innerWidth / 2, window.innerHeight / 2, true);
    });

    // 点击大图：未放大时点击放大；已放大时单机不关闭，双击还原
    cloneImg.addEventListener('click', (e) => {
      e.stopPropagation();
      if (hasDragged) return; // 若本次操作为拖拽移动，不触发缩放
      if (zoomLevel <= 1.05) {
        toggleZoom(e.clientX, e.clientY);
      }
    });

    // 双击大图：快速在 1x 与放大之间来回切换
    cloneImg.addEventListener('dblclick', (e) => {
      e.stopPropagation();
      toggleZoom(e.clientX, e.clientY);
    });

    // 鼠标在图片上平移拖拽 (仅在放大状态下生效)
    cloneImg.addEventListener('mousedown', (e) => {
      if (zoomLevel <= 1.05 || e.button !== 0) return;
      isDragging = true;
      hasDragged = false;
      dragStartX = e.clientX;
      dragStartY = e.clientY;
      startPanX = panX;
      startPanY = panY;
      document.body.classList.add('apple-lightbox-dragging');
      e.preventDefault();
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      const dx = e.clientX - dragStartX;
      const dy = e.clientY - dragStartY;
      if (Math.abs(dx) > 3 || Math.abs(dy) > 3) {
        hasDragged = true;
      }
      panX = startPanX + dx;
      panY = startPanY + dy;
      clampPan();
      applyTransform(false);
    });

    window.addEventListener('mouseup', () => {
      if (!isDragging) return;
      isDragging = false;
      document.body.classList.remove('apple-lightbox-dragging');
      // 释放时顺滑回弹至安全边界内
      clampPan();
      applyTransform(true);
      setTimeout(() => { hasDragged = false; }, 50);
    });

    // 鼠标滚轮平滑缩放与边界处理
    stage.addEventListener('wheel', (e) => {
      if (!isOpen || isAnimating) return;
      e.preventDefault();

      if (e.deltaY < 0) {
        // 滚轮向上 -> 放大
        const newZoom = Math.min(4.5, zoomLevel + 0.25);
        setZoom(newZoom, e.clientX, e.clientY, true);
      } else {
        // 滚轮向下 -> 缩小
        if (zoomLevel > 1.05) {
          const newZoom = Math.max(1.0, zoomLevel - 0.25);
          setZoom(newZoom, e.clientX, e.clientY, true);
        } else {
          // 在 1.0 状态下若用力快速下滑滚轮，触发顺滑关闭
          if (Math.abs(e.deltaY) > 45) {
            closeLightbox();
          }
        }
      }
    }, { passive: false });

    // 触控支持 (单指拖拽平移 / 下滑关闭)
    cloneImg.addEventListener('touchstart', (e) => {
      if (!isOpen) return;
      if (e.touches.length === 1) {
        touchStartY = e.touches[0].clientY;
        if (zoomLevel > 1.05) {
          isDragging = true;
          hasDragged = false;
          dragStartX = e.touches[0].clientX;
          dragStartY = e.touches[0].clientY;
          startPanX = panX;
          startPanY = panY;
        }
      }
    }, { passive: true });

    cloneImg.addEventListener('touchmove', (e) => {
      if (!isOpen || e.touches.length !== 1) return;
      if (zoomLevel > 1.05 && isDragging) {
        const dx = e.touches[0].clientX - dragStartX;
        const dy = e.touches[0].clientY - dragStartY;
        if (Math.abs(dx) > 3 || Math.abs(dy) > 3) hasDragged = true;
        panX = startPanX + dx;
        panY = startPanY + dy;
        clampPan();
        applyTransform(false);
      } else if (zoomLevel <= 1.05) {
        const deltaY = e.touches[0].clientY - touchStartY;
        if (Math.abs(deltaY) > 75) {
          closeLightbox();
        }
      }
    }, { passive: true });

    cloneImg.addEventListener('touchend', () => {
      if (isDragging) {
        isDragging = false;
        clampPan();
        applyTransform(true);
      }
    }, { passive: true });

    // 翻页操作
    prevBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      switchImage(-1);
    });
    nextBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      switchImage(1);
    });

    // 键盘支持 (Esc 退出/还原，方向键切图，+/- 缩放)
    window.addEventListener('keydown', (e) => {
      if (!isOpen) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        if (zoomLevel > 1.05) {
          resetZoom(true);
        } else {
          closeLightbox();
        }
      } else if (e.key === 'ArrowLeft') {
        if (zoomLevel <= 1.05) {
          e.preventDefault();
          switchImage(-1);
        }
      } else if (e.key === 'ArrowRight') {
        if (zoomLevel <= 1.05) {
          e.preventDefault();
          switchImage(1);
        }
      } else if (e.key === '+' || e.key === '=') {
        e.preventDefault();
        setZoom(Math.min(4.5, zoomLevel + 0.35), window.innerWidth / 2, window.innerHeight / 2, true);
      } else if (e.key === '-' || e.key === '_') {
        e.preventDefault();
        setZoom(Math.max(1.0, zoomLevel - 0.35), window.innerWidth / 2, window.innerHeight / 2, true);
      }
    });

    // 全局委托代理所有正文及图版图片的点击事件
    document.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof HTMLElement)) return;

      const img = target.closest('article .prose img, .editorial-plate img, figure img, img[data-zoomable]');
      if (!img || !(img instanceof HTMLImageElement)) return;

      // 排除灯箱内部克隆大图自身、头像、无放大标记的图片
      if (img === cloneImg || img.classList.contains('avatar') || img.classList.contains('no-zoom')) return;
      if (img.closest('.author-card') || img.closest('nav') || img.closest('footer')) return;

      // 阻止默认可能的外层 a 标签链接跳转
      e.preventDefault();
      e.stopPropagation();

      gallery = collectZoomableImages();
      const idx = gallery.indexOf(img);
      if (idx !== -1) {
        openLightbox(idx);
      } else {
        gallery = [img];
        openLightbox(0);
      }
    });
  }

  // 立即初始化并在 Astro 路由切换生命周期中保持就绪
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAppleLightbox);
  } else {
    initAppleLightbox();
  }
  document.addEventListener('astro:page-load', initAppleLightbox);
})();
</script>
