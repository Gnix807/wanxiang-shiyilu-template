  <script is:inline data-astro-rerun>
{
  // 滚动阅读进度条
  if (!window.__scrollBarSetup) {
    window.__scrollBarSetup = true;
    window.addEventListener('scroll', () => {
      const el = document.getElementById('scroll-bar-indicator');
      if (!el) return;
      const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
      const percentage = totalHeight > 0 ? (window.pageYOffset / totalHeight) * 100 : 0;
      el.style.width = percentage + '%';
    }, { passive: true });
  }

  function setupBackToTop() {
    const backToTopBtn = document.getElementById('back-to-top-btn');
    if (!backToTopBtn) return;

    if (!window.__backToTopScrollSetup) {
      window.__backToTopScrollSetup = true;
      window.addEventListener('scroll', () => {
        const btn = document.getElementById('back-to-top-btn');
        if (!btn) return;
        if (window.scrollY > 300) {
          btn.classList.remove('opacity-0', 'pointer-events-none');
          btn.classList.add('opacity-100');
        } else {
          btn.classList.add('opacity-0', 'pointer-events-none');
          btn.classList.remove('opacity-100');
        }
      }, { passive: true });
    }

    backToTopBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  // 全局出版级统一代码视窗增强器
  function setupUnifiedCodeBlocks() {
    // 1. 处理所有原生 Markdown 代码块 <pre>
    document.querySelectorAll('pre').forEach((pre) => {
      // 若已增强或位于已存在的代码块容器内，则跳过
      if (
        pre.hasAttribute('data-enhanced') ||
        pre.closest('[data-codeblock]') ||
        pre.closest('.editorial-codeblock-wrapper') ||
        pre.closest('.editorial-code-window')
      ) {
        return;
      }
      pre.setAttribute('data-enhanced', 'true');

      // 提取语言标识
      let lang = pre.getAttribute('data-language') || '';
      if (!lang) {
        const codeEl = pre.querySelector('code');
        if (codeEl) {
          const cls = Array.from(codeEl.classList).find((c) => c.startsWith('language-'));
          if (cls) lang = cls.replace('language-', '');
        }
        if (!lang) {
          const preCls = Array.from(pre.classList).find((c) => c.startsWith('language-'));
          if (preCls) lang = preCls.replace('language-', '');
        }
      }
      if (!lang || lang.toLowerCase() === 'plaintext') lang = 'CODE';

      // 构建外层与标题栏结构
      const wrapper = document.createElement('div');
      wrapper.className = 'editorial-codeblock-wrapper not-prose my-6';
      wrapper.setAttribute('data-codeblock', 'true');

      const innerBox = document.createElement('div');
      innerBox.className = 'border-2 sm:border-3 border-[#1a1a1a] dark:border-[#e8e6e3] rounded-sm shadow-[4px_4px_0px_0px_#1a1a1a] dark:shadow-[4px_4px_0px_0px_#e8e6e3] overflow-hidden bg-[#faf8f5] dark:bg-[#141413]';

      const header = document.createElement('div');
      header.className = 'flex flex-wrap gap-2 items-center justify-between px-3.5 py-2 bg-[#f0ebe1] dark:bg-[#242220] border-b-2 sm:border-b-3 border-[#1a1a1a] dark:border-[#e8e6e3] text-xs font-mono select-none';
      header.innerHTML = `
        <div class="flex items-center gap-2 min-w-0">
          <div class="flex items-center gap-1.5 shrink-0">
            <span class="w-2.5 h-2.5 rounded-full bg-[#ef4444] border border-[#1a1a1a]/30 dark:border-[#e8e6e3]/30"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#eab308] border border-[#1a1a1a]/30 dark:border-[#e8e6e3]/30"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#22c55e] border border-[#1a1a1a]/30 dark:border-[#e8e6e3]/30"></span>
          </div>
          <span class="font-bold px-1.5 py-0.5 rounded-xs bg-[#1a1a1a] dark:bg-[#e8e6e3] text-white dark:text-[#1a1a1a] text-[10px] tracking-wider uppercase font-mono">${lang.toUpperCase()}</span>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <button type="button" class="code-wrap-btn px-2 py-0.5 border border-[#1a1a1a]/30 dark:border-[#e8e6e3]/30 rounded-xs bg-white/70 dark:bg-transparent hover:bg-[#1a1a1a] hover:text-white dark:hover:bg-[#e8e6e3] dark:hover:text-[#1a1a1a] transition-colors text-[10px] font-bold text-[#1a1a1a] dark:text-[#e8e6e3] cursor-pointer" title="切换自动换行">换行</button>
          <button type="button" class="code-copy-btn px-2.5 py-0.5 border border-[#1a1a1a] dark:border-[#e8e6e3] rounded-xs bg-white dark:bg-[#1c1b1a] hover:bg-[#9e2a2b] hover:text-white dark:hover:bg-[#d9534f] transition-all text-[11px] font-bold text-[#1a1a1a] dark:text-[#e8e6e3] shadow-[1px_1px_0px_0px_#1a1a1a] dark:shadow-[1px_1px_0px_0px_#e8e6e3] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none cursor-pointer flex items-center gap-1" title="复制代码">
            <svg class="copy-icon w-3 h-3 stroke-[2.5]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            <span class="copy-text">复制</span>
          </button>
        </div>
      `;

      const contentBox = document.createElement('div');
      contentBox.className = 'code-content-box p-4 text-sm font-mono overflow-x-auto text-[#24292e] dark:text-[#e1e4e8] leading-relaxed custom-scrollbar relative';

      pre.style.margin = '0';
      pre.style.padding = '0';
      pre.style.border = 'none';
      pre.style.borderRadius = '0';
      pre.style.boxShadow = 'none';
      pre.style.backgroundColor = 'transparent';
      pre.style.overflow = 'visible';

      pre.parentNode.insertBefore(wrapper, pre);
      wrapper.appendChild(innerBox);
      innerBox.appendChild(header);
      innerBox.appendChild(contentBox);
      contentBox.appendChild(pre);
    });

    // 2. 统一为所有代码块绑定交互（包括 Markdown 代码块与 <CodeBlock>）
    document.querySelectorAll('[data-codeblock]').forEach((block) => {
      if (block.__bound) return;
      block.__bound = true;

      const copyBtn = block.querySelector('.code-copy-btn');
      const copyText = block.querySelector('.copy-text');
      const wrapBtn = block.querySelector('.code-wrap-btn');
      const contentBox = block.querySelector('.code-content-box');
      const pre = block.querySelector('pre');

      if (copyBtn && (contentBox || pre)) {
        copyBtn.addEventListener('click', async (e) => {
          e.stopPropagation();
          const codeEl = block.querySelector('code');
          const textToCopy = codeEl ? codeEl.innerText : (pre ? pre.innerText : contentBox.innerText);
          try {
            await navigator.clipboard.writeText(textToCopy.replace(/\r\n/g, '\n').trim());
            if (copyText) copyText.textContent = '已复制';
            copyBtn.classList.add('bg-[#10b981]', 'text-white');
            copyBtn.classList.remove('bg-white', 'dark:bg-[#1c1b1a]');
            setTimeout(() => {
              if (copyText) copyText.textContent = '复制';
              copyBtn.classList.remove('bg-[#10b981]', 'text-white');
              copyBtn.classList.add('bg-white', 'dark:bg-[#1c1b1a]');
            }, 2000);
          } catch (err) {
            console.error('Failed to copy', err);
          }
        });
      }

      if (wrapBtn) {
        let isWrapped = contentBox?.classList.contains('whitespace-pre-wrap') || false;
        if (pre) pre.style.whiteSpace = isWrapped ? 'pre-wrap' : 'pre';
        wrapBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          isWrapped = !isWrapped;
          if (isWrapped) {
            if (pre) pre.style.whiteSpace = 'pre-wrap';
            if (contentBox) {
              contentBox.classList.remove('whitespace-pre');
              contentBox.classList.add('whitespace-pre-wrap');
            }
            wrapBtn.textContent = '不换行';
          } else {
            if (pre) pre.style.whiteSpace = 'pre';
            if (contentBox) {
              contentBox.classList.remove('whitespace-pre-wrap');
              contentBox.classList.add('whitespace-pre');
            }
            wrapBtn.textContent = '换行';
          }
        });
