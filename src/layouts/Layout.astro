---
import { siteConfig, footerConfig } from '../config/site';
import { infoConfig } from '../config/info';
import { seoConfig } from '../config/seo';
import { ClientRouter } from 'astro:transitions';
import NavBar from '../components/NavBar.astro';
import PrefetchLinks from '../components/PrefetchLinks.svelte';
import { PageBanner } from '../components/PageBanner';
// 归档禁用：import MusicPlayer from '../components/MusicPlayer.svelte';
import { execSync } from 'child_process';
import { getCollection } from 'astro:content';
import { countBodyChars } from '../utils/wordCount.mjs';
import '../styles/fonts.css';
import '../index.css';
import '../styles/editorial-components.css';
import SearchModal from '../components/editorial/SearchModal.astro';
import AppleLightbox from '../components/editorial/AppleLightbox.astro';

// 页脚字数统计：与建站统计页共用同一口径（src/utils/wordCount.mjs），
// 否则同一个站会显示两个不同的"总字数"
const footerPosts = await getCollection('posts');
const footerTalks = await getCollection('talks');
const footerChars = footerPosts.reduce((sum, p) => sum + countBodyChars(p.body || ''), 0)
  + footerTalks.reduce((sum, t) => sum + countBodyChars(t.body || ''), 0);
const wordCountK = (footerChars / 1000).toFixed(1);

interface Props {
  title?: string;
  description?: string;
  image?: string;
  categoryName?: string | null;
  tagName?: string | null;
  post?: { title: string; date: string; dateISO?: string; keywords?: string[] } | null;
  keywords?: string[] | null;
  isTalk?: boolean;
  postsCount?: number;
  isAboutPage?: boolean;
  isArticle?: boolean;
  hideFooter?: boolean;
  hideBanner?: boolean;
}

const {
  title,
  description,
  image = seoConfig.defaultImage,
  categoryName = null,
  tagName = null,
  post = null,
  keywords = null,
  isTalk = false,
  postsCount = 0,
  isAboutPage = false,
  isArticle = false,
  hideFooter = false,
  hideBanner = false,
} = Astro.props;

const pageTitle = title
  ? (title === siteConfig.title || title === seoConfig.defaultTitle || title.endsWith(seoConfig.titleTemplate)
      ? title
      : `${title}${seoConfig.titleTemplate}`)
  : siteConfig.title;
const pageDescription = (description || seoConfig.defaultDescription).length < 10 
  ? seoConfig.defaultDescription 
  : (description || seoConfig.defaultDescription);
const pageKeywords = keywords?.length
  ? keywords
  : post?.keywords?.length
    ? post.keywords
    : seoConfig.keywords;

const canonicalURL = new URL(Astro.url.pathname, siteConfig.url).href;
const resolvedImage = image || seoConfig.defaultImage;
const isMusicPage = false; // 音乐页已归档禁用
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={pageKeywords.join(", ")} />
    <meta name="author" content={siteConfig.author} />
    <meta name="robots" content={seoConfig.robots} />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large" />
    <meta name="bingbot" content="index, follow" />
    <meta name="baiduspider" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="msvalidate.01" content="8814B55DAA53801F47B998FE06421544" />

    <!-- Geo Tags -->
    <meta name="geo.region" content="CN-HE" />
    <meta name="geo.placename" content="Shijiazhuang" />
    <meta name="geo.position" content="38.0428;114.5149" />
    <meta name="ICBM" content="38.0428, 114.5149" />
    {/* Favicon - use avatar image */}
    <link rel="icon" href={siteConfig.avatar} />
    <link rel="apple-touch-icon" href={siteConfig.avatar} />
    {/* RSS 2.0 & Atom 1.0 自动发现 */}
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.title} (RSS 2.0)`} href="/rss.xml" />
    <link rel="alternate" type="application/atom+xml" title={`${siteConfig.title} (Atom 1.0)`} href="/atom.xml" />
    {/* WebMCP 工具注册 */}
    <script is:inline src="/webmcp-register.js"></script>

    {/* Open Graph Tags */}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={post ? "article" : "website"} />
    <meta property="og:image" content={resolvedImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:locale" content="zh-CN" />
    <meta property="og:locale:alternate" content="zh_CN" />
    <meta property="og:url" content={canonicalURL} />
    {post && <meta property="article:published_time" content={post.dateISO || post.date} />}
    
    {/* Twitter Card Tags */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={seoConfig.twitter.site} />
    <meta name="twitter:creator" content={seoConfig.twitter.creator} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={resolvedImage} />

    {/* JSON-LD Structured Data */}
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": `${siteConfig.url}/#website`,
          "url": siteConfig.url,
          "name": siteConfig.title,
          "description": siteConfig.description,
          "inLanguage": "zh-CN"
        },
        {
          "@type": "Person",
          "@id": `${siteConfig.url}/#person`,
          "name": siteConfig.author,
          "url": siteConfig.url,
          "image": siteConfig.avatar,
          "sameAs": [
            siteConfig.socials.github
          ]
        },
        ...(post ? [{
          "@type": "Article",
          "@id": `${canonicalURL}#article`,
          "headline": post.title,
          "description": pageDescription,
          "image": resolvedImage,
          "datePublished": post.dateISO || post.date,
          "author": {
            "@type": "Person",
            "name": siteConfig.author,
            "url": siteConfig.url,
            "image": siteConfig.avatar
          },
          "publisher": {
            "@type": "Person",
            "name": siteConfig.author,
            "image": siteConfig.avatar
          },
          "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": canonicalURL
          }
        }] : [])
      ]
    })} />

    {/* Dynamic Prefetch & Preconnect */}
    {seoConfig.dnsPrefetch.map(domain => (
      <link rel="dns-prefetch" href={domain} />
    ))}
    {seoConfig.preconnect.map(conn => (
      <link rel="preconnect" href={conn.url} crossorigin={conn.crossOrigin === "anonymous" ? "anonymous" : undefined} />
    ))}

    {siteConfig.analytics.umami.map(u => (
      <script defer src={u.src} data-website-id={u.id}></script>
    ))}
    {siteConfig.analytics.clarity && (
      <script type="text/javascript" define:vars={{ clarityId: siteConfig.analytics.clarity }}>
        /* Clarity：页面 load 后再加载，不阻塞首屏 */
        window.addEventListener('load', function() {
          (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
          })(window, document, "clarity", "script", clarityId);
        });
      </script>
    )}
  <style is:global>
    @keyframes content-in {
      0% { opacity: 0; transform: translateY(20px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    @keyframes content-out {
      0% { opacity: 1; transform: translateY(0); }
      100% { opacity: 0; transform: translateY(15px); }
    }
    /* Card Specific Entrance - Used for staggered listing */
    @keyframes card-entrance {
      0% { 
        opacity: 0; 
        transform: translateY(30px) scale(0.96);
      }
      70% {
        opacity: 1;
        transform: translateY(-4px) scale(1.02);
      }
      100% { 
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }
    .animate-card-entrance {
      animation: card-entrance 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }
    /* 减弱动态效果：禁用 blur，降低动画幅度 */
    @media (prefers-reduced-motion: reduce) {
      @keyframes content-in {
        0% { opacity: 0; }
        100% { opacity: 1; }
      }
      @keyframes content-out {
        100% { opacity: 0; }
      }
      @keyframes card-entrance {
        0% { opacity: 0; }
        100% { opacity: 1; }
      }
    }

    /* ===== 缓存调试面板：右下角横条 ===== */
    .cache-panel {
      position: fixed;
      bottom: 8px;
      right: 8px;
      z-index: 99999;
      font: 11px/1.4 ui-monospace, monospace;
      color: #94a3b8;
      background: rgba(15, 23, 42, 0.85);
      border: 1px solid #334155;
      border-radius: 6px;
      padding: 6px 10px;
      pointer-events: none;
      white-space: nowrap;
      backdrop-filter: blur(4px);
    }
    .cache-panel-header { display: none; }
    .cache-panel-stats { display: inline; }
    .cache-stat { display: inline; margin: 0 2px; }
    .cache-stat-cached { color: #34d399; }
    .cache-stat-queued { color: #fbbf24; }
    .cache-stat-loading { color: #60a5fa; }
    .cache-stat-hit { color: #34d399; font-weight: 700; }
    .cache-stat-miss { color: #f87171; font-weight: 700; }

    /* ===== HIT/MISS 弹出提示 ===== */
    .cache-toast {
      position: fixed;
      z-index: 999999;
      font: 700 11px/1 ui-monospace, monospace;
      padding: 4px 8px;
      border-radius: 4px;
      pointer-events: none;
      transition: opacity 0.18s ease, transform 0.18s ease;
      transform: translateY(0);
      letter-spacing: 0.02em;
    }
    .cache-toast-hit {
      background: rgba(52, 211, 153, 0.95);
      color: #064e3b;
      box-shadow: 0 2px 8px rgba(52, 211, 153, 0.3);
    }
    .cache-toast-miss {
      background: rgba(248, 113, 113, 0.95);
      color: #7f1d1d;
      box-shadow: 0 2px 8px rgba(248, 113, 113, 0.3);
    }

  </style>
  {/* Dark mode init: read persisted theme before first paint */}
  <script is:inline>
    (function() {
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark') {
          document.documentElement.classList.add('dark');
          document.documentElement.setAttribute('data-theme', 'dark');
        } else if (saved === 'light') {
          document.documentElement.classList.remove('dark');
          document.documentElement.setAttribute('data-theme', 'light');
        }
      } catch (e) {
        // localStorage may be unavailable in some contexts
      }
    })();
  </script>
  <ClientRouter />
</head>
  <body data-bg-url={siteConfig.assets.siteBg || ''} data-is-article={isArticle ? "true" : "false"} class="bg-[#f6eddc] dark:bg-[#141413] text-[#1a1a1a] dark:text-[#e8e6e3] selection:bg-[#9e2a2b]/20 selection:text-[#9e2a2b] dark:selection:text-[#ffffff]">
    {/* Persistent full-page bg layer (survives View Transitions) */}
    <div
      id="site-bg"
      transition:persist="site-bg"
      class="fixed inset-0 -z-10 pointer-events-none"
      aria-hidden="true"
    ></div>
    <div id="site-bg-loader" transition:persist="site-bg-loader" aria-hidden="true">
      <div class="bg-bricks">
        <span class="bg-brick"></span>
        <span class="bg-brick"></span>
        <span class="bg-brick"></span>
      </div>
      <span class="bg-loader-text">loading</span>
      <div class="bg-mini-bar"><i id="site-bg-loader-bar"></i></div>
      <span class="bg-loader-meta" id="site-bg-loader-meta" hidden>0 / 0 · 0%</span>
    </div>
    <!-- Tiny top bar + count only while real resources are loading -->
    <div id="resource-progress" transition:persist="resource-progress" aria-hidden="true">
      <i></i>
      <span id="resource-progress-meta" hidden>0 / 0 · 0%</span>
    </div>
    <!-- Skip to content for keyboard users -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[200] focus:bg-[#1a1a1a] dark:focus:bg-[#e8e6e3] focus:text-white dark:focus:text-[#1a1a1a] focus:px-4 focus:py-2 focus:rounded-sm focus:font-black focus:text-sm focus:shadow-[4px_4px_0px_0px_#9e2a2b] focus:no-underline focus:outline-none">
      跳转到主要内容
    </a>
    {/* Global reading progress bar */}
    <div class="fixed top-0 left-0 w-full h-[5px] bg-transparent z-[110] pointer-events-none">
      <div 
        id="scroll-bar-indicator"
        class="h-full bg-[#9e2a2b] dark:bg-[#d9534f] origin-left w-0 transition-all duration-75"
      ></div>
    </div>
    {/* 缓存系统：面板 + HIT/MISS 弹出提示（persist 保持跨页面） */}
    <div id="cache-panel" class="cache-panel" transition:persist="cache-panel" style="display:none">
      <div class="cache-panel-header">⚡ Cache</div>
      <div id="cache-panel-stats" class="cache-panel-stats">—</div>
    </div>
    <div id="cache-toast" class="cache-toast" transition:persist="cache-toast" style="display:none"></div>
    <script is:inline>
    (function () {
      // 不开 debug 就什么都不运行
      if (sessionStorage.getItem('cacheDebug') !== '1') {
        // 只在 /cachelog 路径开启
        if (window.location.pathname === '/cachelog' || window.location.pathname === '/cachelog/') {
          try { sessionStorage.setItem('cacheDebug', '1'); } catch {}
        } else {
          return; // 不是 debug 模式，直接退出
        }
      }

      var panel = document.getElementById('cache-panel');
      var statsEl = document.getElementById('cache-panel-stats');
      var toast = document.getElementById('cache-toast');
      if (!panel || !statsEl || !toast) return;

      // 更新面板内容
      function updatePanel() {
        panel.style.display = '';
        var s = window.__cacheStats || {};
        var parts = [];
        parts.push('<span class="cache-stat cache-stat-cached">' + (s.cached || 0) + ' cached</span>');
        parts.push('<span class="cache-stat cache-stat-queued">' + (s.queued || 0) + ' queued</span>');
        parts.push('<span class="cache-stat cache-stat-loading">' + (s.loading || 0) + ' loading</span>');
        var last = sessionStorage.getItem('[cache]lastClick');
        if (last) {
          var isHit = last.indexOf('HIT ') === 0;
          var slug = last.replace(/^(HIT|MISS) /, '');
          parts.push('<span class="cache-stat ' + (isHit ? 'cache-stat-hit' : 'cache-stat-miss') + '">' + (isHit ? '✓ HIT ' : '✗ MISS ') + slug + '</span>');
        }
        statsEl.innerHTML = parts.join('');
      }

      updatePanel();
      setInterval(updatePanel, 500);
      document.addEventListener('astro:page-load', updatePanel);
      document.addEventListener('astro:after-swap', updatePanel);

      // HIT/MISS 弹出提示
      var toastTimer = null;
      function showToast(hit, x, y) {
        toast.textContent = hit ? '✓ HIT' : '✗ MISS';
        toast.className = 'cache-toast cache-toast-' + (hit ? 'hit' : 'miss');
        toast.style.left = x + 'px';
        toast.style.top = (y - 30) + 'px';
        toast.style.display = '';
        toast.style.opacity = '1';
        toast.style.transform = 'translateY(0)';
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function () {
          toast.style.opacity = '0';
          toast.style.transform = 'translateY(-8px)';
          setTimeout(function () { toast.style.display = 'none'; }, 200);
        }, 1200);
      }

      // 只在 debug 模式下监听点击（不阻塞导航）
      document.addEventListener('click', function (e) {
        var link = e.target.closest('a[href^="/posts/"]');
        if (!link) return;
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        var url = link.href;
        if (/\/posts\/?$/.test(url)) return;

        var slug = url.split('/').filter(Boolean).pop() || '';
        var absUrl = url.startsWith('http') ? url : location.origin + url;

        // 异步查缓存，不阻塞导航
        caches.open('blog-article-cache-v1').then(function (cache) {
          return cache.match(new Request(absUrl));
        }).then(function (res) {
          if (!res) return false;
          return res.json().then(function (data) {
            return data && data.html && Date.now() - data.ts < 30 * 60 * 1000;
          });
        }).then(function (hit) {
          try { sessionStorage.setItem('[cache]lastClick', (hit ? 'HIT ' : 'MISS ') + slug); } catch {}
          showToast(hit, e.clientX, e.clientY);
          updatePanel();
        }).catch(function () {});
      }, true);
    })();
    </script>
    {/* 暂时禁用：<WelcomeToast /> */}
    <div class={isMusicPage ? 'flex flex-col h-[100dvh] overflow-hidden' : 'flex flex-col min-h-screen'}>
      <NavBar />
      
      {!isAboutPage ? (
        <div 
          class={`px-2 font-sans transition-all duration-300 ${
            isMusicPage
              ? 'h-full overflow-hidden'
              : 'min-h-screen py-2 sm:py-6 sm:px-6 md:py-8 md:px-8'
          } ${isArticle ? "article-paper-shell" : ""}`}
        >
          <div class="max-w-[1440px] w-full mx-auto flex flex-col gap-3 sm:gap-6">
            {!hideBanner && (
            <PageBanner 
              client:load
              pathname={Astro.url.pathname}
              categoryName={categoryName}
              tagName={tagName}
              post={post}
              postsCount={postsCount}
            />
            )}

            <main
              id="main-content"
              class="flex-1"
              transition:animate={{
                forwards: {
                  old: [{ name: 'content-out', duration: '0.2s', easing: 'ease-in' }],
                  new: [{ name: 'content-in', duration: '0.35s', easing: 'ease-out' }]
                },
                backwards: {
                  old: [{ name: 'content-out', duration: '0.2s', easing: 'ease-in' }],
                  new: [{ name: 'content-in', duration: '0.35s', easing: 'ease-out' }]
                }
              }}
            >
              <slot />
            </main>
          </div>
        </div>
      ) : (
        <main class="flex-1">
          <slot />
        </main>
      )}
      
      {!hideFooter && (
      <footer class="w-full select-none">
        <div class="max-w-5xl mx-auto px-4 py-6 text-center text-xs font-mono text-[#1a1a1a] dark:text-[#e8e6e3] leading-relaxed space-y-3">
          {/* 导航链接：经典出版物边框按钮组 */}
          <div class="flex flex-wrap justify-center gap-2">
            {infoConfig.footer.links.map((link) => (
              <a href={link.path} target={link.external ? "_blank" : undefined} rel={link.external ? "noopener noreferrer" : undefined}
                 class="px-3 py-1 border-2 border-[#1a1a1a] dark:border-[#e8e6e3] rounded-sm font-black text-xs text-[#1a1a1a] dark:text-[#e8e6e3] bg-[#ffffff] dark:bg-[#1c1b1a] shadow-[2px_2px_0px_0px_#1a1a1a] dark:shadow-[2px_2px_0px_0px_#e8e6e3] hover:bg-[#9e2a2b] hover:text-white hover:border-[#9e2a2b] dark:hover:bg-[#d9534f] dark:hover:border-[#d9534f] hover:-translate-y-0.5 hover:shadow-[3px_3px_0px_0px_#1a1a1a] active:translate-y-0 active:shadow-[1px_1px_0px_0px_#1a1a1a] transition-all whitespace-nowrap">
                {link.name}
              </a>
            ))}
          </div>
          {/* 版权 + 备案 */}
          <div class="font-bold">
            <span>{infoConfig.footer.copyrightText}</span>
            {infoConfig.footer.icp.text && <>
              <span class="mx-1.5 text-neutral-400">·</span>
              <a href={infoConfig.footer.icp.link} target="_blank" rel="noopener noreferrer" class="text-[#9e2a2b] dark:text-[#d9534f] hover:underline">{infoConfig.footer.icp.text}</a>
            </>}
          </div>
          <div>
            <span>{footerConfig.repoText}</span><a href={footerConfig.repoUrl} class="hover:text-[#9e2a2b] underline font-bold">{footerConfig.repoDisplayName}</a>
            {(() => {
              try {
                const log = execSync('git log -n 1 --pretty=format:"%h||%ci"').toString().trim();
                const [hash, dateRaw] = log.split('||');
                const d = dateRaw ? new Date(dateRaw) : null;
                const formattedDate = d
                  ? `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')} ${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`
                  : '';
                return <>
                  <span class="mx-1">·</span>
                  <a href={`${footerConfig.repoUrl}/commit/${hash}`} class="hover:text-[#9e2a2b] underline font-bold">{hash}</a>
                  {formattedDate && <><span class="mx-0.5">·</span><span>{formattedDate}</span></>}
                </>;
              } catch (e) {
                console.warn('[Layout] Git info unavailable at build time');
                return null;
              }
            })()}
          </div>
          <div class="font-bold">
            本站文章与说说累计 <span class="text-[#9e2a2b] dark:text-[#d9534f]">{wordCountK}k 字</span>
          </div>
          <div id="footer-uptime" data-start={siteConfig.startTime.getTime()} class="text-[10px] sm:text-xs text-neutral-500 dark:text-neutral-400">
            本站已在互联网中航行 <span id="uptime-display" class="font-bold text-[#9e2a2b] dark:text-[#d9534f]">计算中...</span>
          </div>
          {/* 博客架构徽章：Neo-Brutalist 粗野主义风格 */}
          <div class="flex flex-wrap items-center justify-center gap-2 pt-1">
            <a 
              href="https://astro.build" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="group inline-flex items-center gap-1.5 px-3 py-1 border-2 border-[#1a1a1a] dark:border-[#e8e6e3] rounded-sm bg-[#ffffff] dark:bg-[#1c1b1a] text-[#1a1a1a] dark:text-[#e8e6e3] shadow-[2px_2px_0px_0px_#1a1a1a] dark:shadow-[2px_2px_0px_0px_#e8e6e3] hover:bg-[#9e2a2b] hover:text-white hover:border-[#9e2a2b] dark:hover:bg-[#d9534f] dark:hover:border-[#d9534f] hover:-translate-y-0.5 hover:shadow-[3px_3px_0px_0px_#1a1a1a] active:translate-y-0 active:shadow-[1px_1px_0px_0px_#1a1a1a] transition-all font-mono font-bold text-xs"
              title="Astro: The web framework for content-driven websites"
            >
