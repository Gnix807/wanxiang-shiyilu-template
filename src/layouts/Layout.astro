<script is:inline>
  (function () {
    function applySiteBg() {
      var el = document.getElementById('site-bg');
      if (!el) return;
      var loader = document.getElementById('site-bg-loader');
      var isArticle = document.body && document.body.dataset.isArticle === 'true';
      var url = document.body && document.body.getAttribute('data-bg-url');
      if (isArticle || !url) {
        var isDark = document.documentElement.classList.contains('dark');
        el.style.backgroundColor = isDark ? '#141413' : '#f6eddc';
        el.style.backgroundImage = isDark
          ? 'radial-gradient(circle, rgba(255,255,255,0.04) 1px, transparent 1px)'
          : 'radial-gradient(circle, rgba(26,26,26,0.045) 1px, transparent 1px)';
        el.style.backgroundSize = '24px 24px';
        el.style.backgroundPosition = '0 0';
        el.style.backgroundRepeat = 'repeat';
        el.style.backgroundAttachment = isArticle ? 'fixed' : 'scroll';
        el.classList.add('is-ready');
        if (loader) loader.classList.remove('is-on');
        return;
      }

      if (el.dataset.bgUrl === url && el.classList.contains('is-ready')) {
        paintBg();
        if (loader) loader.classList.remove('is-on');
        return;
      }

      // Keep the current CSS background in place and only re-paint it with
      // the same image instead of swapping to an empty dot grid first.
      el.dataset.bgUrl = url;
      paintBg();

      function paintBg() {
        var isDark = document.documentElement.classList.contains('dark');
        var overlay = isDark
          ? 'linear-gradient(rgba(20,20,19,0.72), rgba(20,20,19,0.72))'
          : 'linear-gradient(rgba(250,248,245,0.48), rgba(250,248,245,0.48))';
        el.style.backgroundImage =
          'radial-gradient(circle, rgba(253,246,227,0.35) 1px, transparent 1px),' +
          overlay + ',' +
          'url(' + url + ')';
        el.style.backgroundSize = '24px 24px, cover, cover';
        el.style.backgroundPosition = '0 0, center, center';
        el.style.backgroundRepeat = 'repeat, no-repeat, no-repeat';
        el.style.backgroundAttachment = 'scroll, scroll, scroll';
        el.classList.add('is-ready');
        if (loader) loader.classList.remove('is-on');
      }

      var bgPromise = new Promise(function (resolve) {
        var img = new Image();
        img.onload = function () {
          el.dataset.bgUrl = url;
          paintBg();
          resolve();
        };
        img.onerror = function () {
          el.style.backgroundImage =
            'radial-gradient(circle, rgba(253,246,227,0.35) 1px, transparent 1px),' +
            'linear-gradient(rgba(250,248,245,0.55), rgba(250,248,245,0.55))';
          el.style.backgroundSize = '24px 24px, cover';
          el.style.backgroundPosition = '0 0, center';
          el.style.backgroundRepeat = 'repeat, no-repeat';
          el.style.backgroundAttachment = 'scroll, scroll';
          el.classList.add('is-ready');
          if (loader) loader.classList.remove('is-on');
          resolve();
        };
        img.src = url;
        if (img.complete) {
          el.dataset.bgUrl = url;
          paintBg();
          resolve();
        }
      });
      if (typeof window.__blogTrackResource === 'function') {
        window.__blogTrackResource(bgPromise);
      } else {
        window.__blogPendingRes = window.__blogPendingRes || [];
        window.__blogPendingRes.push(bgPromise);
      }
    }

    function onPage() {
      applySiteBg();
    }

    applySiteBg();
    if (!window.__blogBgBeatInited) {
      window.__blogBgBeatInited = true;
      document.addEventListener('astro:after-swap', applySiteBg);
      document.addEventListener('astro:page-load', onPage);
      window.addEventListener('theme-change', applySiteBg);
    }
  })();
</script>
<script>
  (function () {
    var totalRes = 0;
    var doneRes = 0;
    var hideTimer = null;

    function setProgressUI(done, total) {
      var top = document.getElementById('resource-progress');
      var topBar = top && top.querySelector('i');
      var topMeta = document.getElementById('resource-progress-meta');
      var entryBar = document.getElementById('site-bg-loader-bar');
      var entryMeta = document.getElementById('site-bg-loader-meta');
      // never show empty 0/0
      if (!total || total <= 0) {
        if (top) top.classList.remove('is-on');
        if (topBar) topBar.style.width = '0%';
        if (topMeta) { topMeta.hidden = true; topMeta.textContent = ''; }
        if (entryBar) entryBar.style.width = '0%';
        if (entryMeta) { entryMeta.hidden = true; entryMeta.textContent = ''; }
        return;
      }
      var pct = Math.min(100, Math.round((done / total) * 100));
      var label = done + ' / ' + total + ' · ' + pct + '%';
      if (topBar) topBar.style.width = pct + '%';
      if (entryBar) entryBar.style.width = pct + '%';
      if (topMeta) { topMeta.hidden = false; topMeta.textContent = label; }
      if (entryMeta) { entryMeta.hidden = false; entryMeta.textContent = label; }
      if (top) {
        if (done < total) {
          top.classList.add('is-on');
        } else {
          // snap to 100% then hide
          if (topBar) topBar.style.width = '100%';
          if (entryBar) entryBar.style.width = '100%';
          if (topMeta) topMeta.textContent = total + ' / ' + total + ' · 100%';
          if (entryMeta) entryMeta.textContent = total + ' / ' + total + ' · 100%';
          clearTimeout(hideTimer);
          hideTimer = setTimeout(function () {
            if (top) top.classList.remove('is-on');
            if (topMeta) topMeta.hidden = true;
            if (entryMeta) entryMeta.hidden = true;
          }, 320);
        }
      }
    }

    function bumpDone() {
      doneRes = Math.min(totalRes, doneRes + 1);
      setProgressUI(doneRes, totalRes);
    }

    function trackResource(promiseLike) {
      totalRes += 1;
      setProgressUI(doneRes, totalRes);
      Promise.resolve(promiseLike).then(bumpDone, bumpDone);
    }

    window.__blogTrackResource = trackResource;
    if (window.__blogPendingRes && window.__blogPendingRes.length) {
      var pending = window.__blogPendingRes.slice();
      window.__blogPendingRes = [];
      for (var pi = 0; pi < pending.length; pi++) trackResource(pending[pi]);
    }

    function scan(root) {
      if (!root || !root.querySelectorAll) return;
      var els = root.querySelectorAll('img, iframe, video');
      for (var i = 0; i < els.length; i++) {
        (function (el) {
          if (el.tagName === 'IMG' && el.complete) return;
          trackResource(new Promise(function (resolve) {
            el.addEventListener('load', resolve, { once: true });
            el.addEventListener('error', resolve, { once: true });
          }));
        })(els[i]);
      }
    }

    function boot() {
      scan(document);
      var mo = new MutationObserver(function (mutations) {
        for (var m = 0; m < mutations.length; m++) {
          var added = mutations[m].addedNodes;
          for (var n = 0; n < added.length; n++) {
            if (added[n].nodeType === 1) scan(added[n]);
          }
        }
      });
      try {
        mo.observe(document.documentElement, { childList: true, subtree: true });
      } catch (e) {}
    }

    document.addEventListener('astro:page-load', function () {
      totalRes = 0;
      doneRes = 0;
      setProgressUI(0, 0);
      scan(document);
    });
  })();
</script>

