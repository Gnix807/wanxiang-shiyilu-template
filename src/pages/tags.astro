---
import Layout from '../layouts/Layout.astro';
import { getProcessedPosts } from '../utils/postsFetcher';
import { i18nConfig } from '../config/site';

const allPosts = await getProcessedPosts();

const tagMap: Record<string, number> = {};
allPosts.forEach(post => {
  if (post.tags) {
    post.tags.forEach(tag => {
      tagMap[tag] = (tagMap[tag] || 0) + 1;
    });
  }
});

const tags = Object.entries(tagMap)
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count);
---

<Layout
  title="标签 - 全部"
  description="博客全部标签"
  keywords={['标签', '博客标签', '分类索引']}
  postsCount={tags.length}
>
  <div class="w-full max-w-3xl mx-auto">
    <div class="bg-white dark:bg-[#1c1b1a] border-3 sm:border-4 border-[#1a1a1a] dark:border-[#e8e6e3] p-6 md:p-10 shadow-[6px_6px_0px_0px_#1a1a1a] dark:shadow-[6px_6px_0px_0px_#e8e6e3] rounded-sm animate-card-entrance opacity-0">
      <div class="flex items-center gap-3 mb-6 border-b-2 border-dashed border-[#1a1a1a]/20 dark:border-[#e8e6e3]/20 pb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 stroke-[2.5] text-[#9e2a2b] dark:text-[#d9534f]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14" />
        </svg>
        <h1 class="text-xl md:text-2xl font-black text-[#1a1a1a] dark:text-[#e8e6e3] font-serif">
          标签
        </h1>
        <span class="text-xs font-bold text-neutral-400 font-mono">({tags.length} 个)</span>
      </div>

      <div class="flex flex-wrap gap-3">
        {tags.map(tag => (
          <a
            href={`/tag/${tag.name}`}
            class="group inline-flex items-center gap-2 px-4 py-2 bg-[#f4efe6] dark:bg-[#242220] border-2 border-[#1a1a1a] dark:border-[#e8e6e3] rounded-sm shadow-[3px_3px_0px_0px_#1a1a1a] dark:shadow-[3px_3px_0px_0px_#e8e6e3] hover:shadow-none hover:bg-[#9e2a2b] hover:border-[#9e2a2b] dark:hover:bg-[#d9534f] dark:hover:border-[#d9534f] hover:translate-x-0.5 hover:translate-y-0.5 transition-all duration-200"
          >
            <span class="font-black text-sm text-neutral-800 dark:text-neutral-200 group-hover:text-white transition-colors">#{tag.name}</span>
            <span class="text-[10px] font-bold text-neutral-500 font-mono bg-white dark:bg-[#1c1b1a] group-hover:bg-[#7f2223] group-hover:text-white dark:group-hover:bg-[#b03a37] border border-[#1a1a1a]/20 dark:border-[#e8e6e3]/20 group-hover:border-transparent px-1.5 py-0.5 rounded-sm transition-colors">{tag.count}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>
