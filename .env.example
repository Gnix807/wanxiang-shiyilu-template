# Optional. Set this to your final public URL, without a trailing slash.
PUBLIC_SITE_URL=

# Optional build-time IndexNow verification key; never prefix secrets with PUBLIC_.
INDEXNOW_KEY=

# Optional commit history API refresh. Off by default; local Git needs no token.
COMMIT_INDEX_FETCH=0
COMMIT_INDEX_REPO=
COMMIT_INDEX_TOKEN=

# Set to 1 for deterministic builds without fetching optional Bilibili profile data.
BUILD_OFFLINE=0
